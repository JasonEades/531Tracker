@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<div class="app-container">
    <div class="layout-body">
        <nav class="sidebar">
            <div class="sidebar-brand">
                <a href="/" class="brand">
                    <img src="images/liftinglablogo.png" alt="The Lifting Lab" class="brand-logo" />
                    <span class="brand-text">The Lifting Lab</span>
                </a>
            </div>
            <UserStrip />
            <NavMenu />
        </nav>
        <div class="main-column">
            <header class="top-bar">
                <div class="top-bar-inner">
                    <a href="/" class="brand">
                        <img src="images/liftinglablogo.png" alt="The Lifting Lab" class="brand-logo" />
                        <span class="brand-text">The Lifting Lab</span>
                    </a>
                    <div class="top-bar-user">
                        <UserStrip />
                    </div>
                </div>
            </header>
            <main class="main-content">
                @Body
            </main>
        </div>
    </div>

    <nav class="bottom-tab-bar">
        <NavMenu />
    </nav>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = AppTheme.Create();
}
