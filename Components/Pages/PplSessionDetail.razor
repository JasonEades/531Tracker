@page "/ppl/session/{SessionId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IPplSessionService SessionService
@inject IPplProgressionService Progression
@inject IPplExerciseSwapService SwapService
@inject IPlateCalculatorService PlateCalc
@inject NavigationManager Nav

<PageTitle>PPL Session — Jason's Garage Lab</PageTitle>

@if (loading)
{
    <div class="loading"><div class="spinner"></div></div>
}
else if (session is null)
{
    <div class="empty-state">
        <h3>Session not found</h3>
        <button class="btn btn-outline mt-1" @onclick='() => Nav.NavigateTo("/")'>Back to Dashboard</button>
    </div>
}
else
{
    @* ── Header ─────────────────────────────────────────────── *@
    <div class="workout-header">
        <button class="btn btn-ghost btn-sm back-btn" @onclick='() => Nav.NavigateTo(ReturnProgramId > 0 ? $"/ppl/{ReturnProgramId}" : "/")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back
        </button>
        <div class="workout-title-row">
            <div>
                <h1>@session.DayTemplate.Name</h1>
                <div class="workout-meta-line">
                    @session.Program.Name
                    <span class="badge @GetStatusBadgeClass(session.Status) ml-1">@GetStatusLabel(session.Status)</span>
                    <span class="badge @GetDayTypeBadge(session.DayTemplate.DayType) ml-1">@session.DayTemplate.DayType</span>
                </div>
            </div>
            <div class="workout-actions">
                <ExportButtons Scope="WorkoutExportScope.PplSession" Id="SessionId" Label="workout" OnError="m => exportError = m" />
                @if (session.Status == WorkoutStatus.NotStarted)
                {
                    <button class="btn btn-primary" @onclick="StartSession">▶ Start</button>
                }
                @if (session.Status == WorkoutStatus.Completed)
                {
                    <button class="btn btn-outline btn-sm" @onclick="ReopenSession">↩ Reopen</button>
                }
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(exportError))
        {
            <div class="alert alert-danger mt-2">@exportError</div>
        }
    </div>

    <div class="session-date-row">
        <label for="ppl-session-date">Session date</label>
        <input id="ppl-session-date" class="form-control form-control-sm" type="date" @bind="sessionDate" />
        <button class="btn btn-outline btn-sm" @onclick="SaveSessionDate" disabled="@savingSessionDate">
            @(savingSessionDate ? "Saving…" : "Save Date")
        </button>
    </div>

    <div class="session-date-row">
        <label for="ppl-session-rest">Rest timer</label>
        <input id="ppl-session-rest" class="form-control form-control-sm" type="number" min="0" max="600" step="5"
               value="@restSeconds" @onchange="SaveRestSeconds" />
        <span class="text-muted">seconds</span>
        @if (restRemaining > 0)
        {
            <span class="badge badge-warning">@FormatRest(restRemaining)</span>
            <button class="btn btn-outline btn-sm" @onclick="StopRestTimer">Stop</button>
        }
    </div>

    <RestTimerOverlay RemainingSeconds="restRemaining" OnStop="StopRestTimer" />

    <div class="workout-notes-section">
        <div class="section-heading-row">
            <div>
                <h2 class="section-heading">Workout Notes</h2>
                <p class="section-subtitle">Use Voice Notes from anywhere on this page; dictated phrases save automatically.</p>
            </div>
            <button class="btn btn-sm btn-primary" @onclick="SaveSessionNotes" disabled="@savingSessionNotes">
                @(savingSessionNotes ? "Saving…" : "Save Notes")
            </button>
        </div>
        <textarea class="form-control workout-notes-input" rows="5" @bind="session.Notes"
                  placeholder="How did this workout feel? Record form cues, pain, energy, recovery, or changes."></textarea>
    </div>

    @if (session.Status != WorkoutStatus.Completed)
    {
        <VoiceNotesButton OnTranscript="AppendVoiceNotes" Disabled="@savingVoiceNotes" />
    }

    @* ── Progress bar ────────────────────────────────────────── *@
    <div class="sets-progress mb-3">
        <div class="flex items-center justify-between mb-1">
            <span class="sets-progress-label">Sets Completed</span>
            <span class="sets-progress-label">@SetsDone / @SetsTotal</span>
        </div>
        <div class="progress-bar-wrapper">
            <div class="progress-bar-fill" style="width:@SetsPct%"></div>
        </div>
    </div>

    @* ── Exercise cards ──────────────────────────────────────── *@
    @if (setError is not null)
    {
        <div class="alert alert-danger">@setError</div>
    }
    @foreach (var exercise in session.Exercises.OrderBy(e => e.OrderInSession))
    {
        var isOneOffSwap = exercise.IsOneOffSwap;
        var e1Rm = exercise.EffectiveIsBodyweight ? null : Progression.CalculateE1Rm(exercise);
        var canSwap = session.Status != WorkoutStatus.Completed && !exercise.IsAddedToSession && !exercise.Sets.Any(s => s.IsCompleted);
        var exerciseBar = BarFor(exercise);

        <div class="ppl-exercise-section">
            <div class="ppl-exercise-header">
                <div>
                    <div class="ppl-exercise-name">@exercise.ExerciseName</div>
                    <div class="ppl-exercise-meta">
                        <span class="badge badge-muted">@exercise.TargetSets×@exercise.RepsMin–@exercise.RepsMax</span>
                        @if (exercise.EffectiveMuscleGroup is MuscleGroup muscleGroup)
                        {
                            <span class="badge @GetMuscleGroupBadge(muscleGroup)">@muscleGroup</span>
                        }
                        @if (exercise.IsAddedToSession)
                        {
                            <span class="badge badge-muted" title="Added to this session only; your plan is unchanged">＋ Added this workout</span>
                        }
                        @if (isOneOffSwap)
                        {
                            <span class="badge badge-muted" title="Plan exercise: @exercise.ExerciseSlot!.ExerciseName">⇄ Swapped for this workout</span>
                        }
                         @if (!exercise.SuggestedWeight.HasValue && !exercise.EffectiveIsBodyweight)
                         {
                             <span class="badge badge-warning">⚠ Starting weight not set</span>
                         }
                        @if (e1Rm is > 0)
                        {
                            <span class="badge badge-muted">e1RM @DisplayWeight(e1Rm) lbs</span>
                        }
                    </div>
                </div>
                @if (canSwap && swapExerciseId != exercise.Id)
                {
                    <button class="btn btn-outline btn-sm" @onclick="() => OpenSwap(exercise.Id)">⇄ Swap</button>
                }
                @if (exercise.IsAddedToSession && session.Status != WorkoutStatus.Completed)
                {
                    @if (confirmRemoveExerciseId == exercise.Id)
                    {
                        <div class="ppl-swap-actions">
                            <button class="btn btn-danger btn-sm" @onclick="() => RemoveAddedExercise(exercise)">Remove @exercise.ExerciseName</button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => confirmRemoveExerciseId = null">Keep</button>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-ghost btn-sm" title="Remove from this workout" @onclick="() => confirmRemoveExerciseId = exercise.Id">✕ Remove</button>
                    }
                }
            </div>

            @if (swapExerciseId == exercise.Id)
            {
                <div class="ppl-swap-panel">
                    @if (swapOptions.Count == 0 && accessoryOptions.Count == 0)
                    {
                        <p class="text-muted">No other @exercise.EffectiveMuscleGroup exercises or accessories available. Add a custom exercise in the exercise library or an accessory on the Accessories page.</p>
                    }
                    else
                    {
                        <label for="swap-@exercise.Id">Replace @exercise.ExerciseName with</label>
                        <select id="swap-@exercise.Id" class="form-control form-control-sm" @bind="swapSelection">
                            @if (swapOptions.Count > 0)
                            {
                                <optgroup label="@($"{exercise.EffectiveMuscleGroup} exercises")">
                                    @foreach (var option in swapOptions)
                                    {
                                        <option value="d:@option.Id">@option.Name@(string.IsNullOrWhiteSpace(option.Equipment) ? "" : $" — {option.Equipment}")</option>
                                    }
                                </optgroup>
                            }
                            @if (accessoryOptions.Count > 0)
                            {
                                <optgroup label="Your accessories (last weight)">
                                    @foreach (var option in accessoryOptions)
                                    {
                                        <option value="a:@option.AccessoryId">@FormatAccessoryOption(option)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <div class="ppl-swap-actions">
                            <button class="btn btn-primary btn-sm" disabled="@swapping" @onclick="() => ConfirmSwap(PplSwapScope.ThisWorkout)">This workout only</button>
                            <button class="btn btn-outline btn-sm" disabled="@swapping" @onclick="() => ConfirmSwap(PplSwapScope.FutureWorkouts)">All future workouts</button>
                        </div>
                    }
                    @if (swapError is not null)
                    {
                        <p class="text-danger">@swapError</p>
                    }
                    <button class="btn btn-ghost btn-sm" @onclick="CloseSwap">Cancel</button>
                </div>
            }

            @if (!exercise.EffectiveIsBodyweight)
            {
                <div class="ppl-bar-row">
                    @if (barPickerExerciseId == exercise.Id)
                    {
                        <select id="bar-@exercise.Id" class="form-control form-control-sm" aria-label="Bar for @exercise.ExerciseName" value="@(exercise.BarId ?? 0)"
                                @onchange="e => OnExerciseBarSelected(exercise, e)">
                            <option value="0">Default — @(defaultBar?.Name ?? "Bar") (@FormatPlate(defaultBar?.Weight ?? 45) lbs)</option>
                            @foreach (var bar in bars.Where(b => !b.IsDefault))
                            {
                                <option value="@bar.Id">@bar.Name (@FormatPlate(bar.Weight) lbs)</option>
                            }
                        </select>
                        <button class="btn btn-ghost btn-sm" @onclick="() => barPickerExerciseId = null">Done</button>
                    }
                    else
                    {
                        <span class="ppl-bar-label">Bar: <strong>@exerciseBar.Name</strong> (@FormatPlate(exerciseBar.Weight) lbs)</span>
                        @if (session.Status != WorkoutStatus.Completed)
                        {
                            <button class="btn btn-ghost btn-sm" @onclick="() => barPickerExerciseId = exercise.Id">Change bar</button>
                        }
                    }
                </div>
            }

            @foreach (var set in exercise.Sets.OrderBy(s => s.SetNumber))
            {
                <div class="set-card @(set.IsCompleted ? "completed-set" : "")">
                    <div class="set-num">@set.SetNumber</div>
                    <div class="set-info">
                        <div class="set-weight-label">
                    @DisplayWeight(set.ActualWeight ?? exercise.SuggestedWeight) <span class="set-unit">lbs</span>
                        </div>
                        <div class="set-reps-label">× @set.TargetReps reps target</div>
                    </div>
                    <div class="set-inputs">
                        @if (!exercise.EffectiveIsBodyweight)
                        {
                            <input class="set-input" type="number" inputmode="numeric"
                                   value="@DisplayWeight(set.ActualWeight ?? exercise.SuggestedWeight)"
                                   @onchange="e => OnWeightChanged(set, exercise, e)" step="2.5" min="0" max="@PplSessionService.MaxWeight"
                                   disabled="@(session.Status == WorkoutStatus.Completed)" />
                        }
                        <input class="set-input" type="number" inputmode="numeric"
                               value="@(set.ActualReps ?? set.TargetReps)"
                               @onchange="e => OnRepsChanged(set, e)" min="0" max="@PplSessionService.MaxReps"
                               disabled="@(session.Status == WorkoutStatus.Completed)" />
                    </div>
                    <button class="check-btn @(set.IsCompleted ? "checked" : "")"
                            @onclick="() => ToggleSet(set, exercise)"
                            disabled="@(session.Status == WorkoutStatus.Completed)">
                        @(set.IsCompleted ? "✓" : "")
                    </button>
                    @if (session.Status != WorkoutStatus.Completed && exercise.Sets.Count > 1)
                    {
                        <button class="set-remove-btn" title="Remove set @set.SetNumber" aria-label="Remove set @set.SetNumber"
                                @onclick="() => RemoveSet(set)">✕</button>
                    }
                    <div class="set-history">
                        @{
                            var currentSetWeight = exercise.EffectiveIsBodyweight ? null : set.ActualWeight ?? exercise.SuggestedWeight;
                            var sameWeight = FindSameWeightPrevious(exercise, set.SetNumber, currentSetWeight);
                            var last = previousSets.TryGetValue(exercise.Id, out var lastSets) && lastSets.TryGetValue(set.SetNumber, out var lastSet) ? lastSet : null;
                            // Same-weight result from the latest session already says everything the "Last" line would.
                            var sameIsLatest = sameWeight is not null && last is not null && last.Source is null && last.OccurredOn == sameWeight.OccurredOn;
                        }
                        @if (sameWeight is not null)
                        {
                            <div class="set-last-label set-same-weight-label" title="@($"{sameWeight.OccurredOn:MMM d}")">
                                You got <strong>@sameWeight.Reps</strong> reps on this set last time@(sameWeight.Weight is null ? "" : $" at {DisplayWeight(sameWeight.Weight)} lbs")@(sameIsLatest ? "" : $" ({sameWeight.OccurredOn:MMM d})")
                            </div>
                        }
                        @if (last is not null && !sameIsLatest)
                        {
                            <div class="set-last-label" title="@($"Last session: {last.OccurredOn:MMM d}{(last.Source is null ? "" : $" ({last.Source})")}")">
                                Last@(last.Source is null ? "" : $" ({last.Source})"): <strong>@last.Reps</strong> reps@(exercise.EffectiveIsBodyweight || last.Weight is null ? "" : $" @ {DisplayWeight(last.Weight)} lbs")
                            </div>
                        }
                        @if (!exercise.EffectiveIsBodyweight &&
                             (set.ActualWeight ?? exercise.SuggestedWeight) is double setWeight &&
                             plateMap.TryGetValue((setWeight, exerciseBar.Weight), out var plates) &&
                             plates.Count > 0)
                        {
                            <div class="plate-chips-inline">
                                @foreach (var p in plates)
                                {
                                    @for (int i = 0; i < p.CountPerSide; i++)
                                    {
                                        <span class="plate-chip-sm @PlateTone.For(p.PlateWeight)">@FormatPlate(p.PlateWeight)</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            @if (session.Status != WorkoutStatus.Completed)
            {
                <button class="btn btn-ghost btn-sm" @onclick="() => AddSet(exercise)">+ Add set</button>
            }

        </div>
    }

    @if (session.Status != WorkoutStatus.Completed)
    {
        <div class="ppl-exercise-section ppl-add-exercise">
            @if (!addingExercise)
            {
                <button class="btn btn-outline btn-sm" @onclick="OpenAddExercise">＋ Add exercise to this workout</button>
            }
            else
            {
                <div class="ppl-swap-panel">
                    <label for="add-exercise-select">Add to this workout only (your plan is unchanged)</label>
                    @if (addOptions.Exercises.Count == 0 && addOptions.Accessories.Count == 0)
                    {
                        <p class="text-muted">Nothing left to add. Create a custom exercise in the exercise library first.</p>
                    }
                    else
                    {
                        <select id="add-exercise-select" class="form-control form-control-sm" @bind="addSelection">
                            @foreach (var group in addOptions.Exercises.GroupBy(d => d.PrimaryMuscle))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var option in group)
                                    {
                                        <option value="d:@option.Id">@option.Name@(string.IsNullOrWhiteSpace(option.Equipment) ? "" : $" — {option.Equipment}")</option>
                                    }
                                </optgroup>
                            }
                            @if (addOptions.Accessories.Count > 0)
                            {
                                <optgroup label="Your accessories (last weight)">
                                    @foreach (var option in addOptions.Accessories)
                                    {
                                        <option value="a:@option.AccessoryId">@FormatAccessoryOption(option)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="add-exercise-sets">Sets</label>
                                <input id="add-exercise-sets" class="form-control form-control-sm" type="number" min="1" max="10" @bind="addSets" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="add-exercise-reps-min">Reps min</label>
                                <input id="add-exercise-reps-min" class="form-control form-control-sm" type="number" min="1" max="@PplSessionService.MaxReps" @bind="addRepsMin" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="add-exercise-reps-max">Reps max</label>
                                <input id="add-exercise-reps-max" class="form-control form-control-sm" type="number" min="1" max="@PplSessionService.MaxReps" @bind="addRepsMax" />
                            </div>
                        </div>
                        <div class="ppl-swap-actions">
                            <button class="btn btn-primary btn-sm" disabled="@savingAddedExercise" @onclick="ConfirmAddExercise">
                                @(savingAddedExercise ? "Adding…" : "Add exercise")
                            </button>
                        </div>
                    }
                    @if (addError is not null)
                    {
                        <p class="text-danger">@addError</p>
                    }
                    <button class="btn btn-ghost btn-sm" @onclick="CloseAddExercise">Cancel</button>
                </div>
            }
        </div>
    }

    @* ── Finish button ───────────────────────────────────────── *@
    @if (session.Status == WorkoutStatus.InProgress)
    {
        <div class="sticky-action">
            <button class="btn btn-success btn-full btn-lg" @onclick="CompleteSession">
                ✓ Finish Session
            </button>
        </div>
    }
}

@code {
    [Parameter] public int SessionId { get; set; }
    [SupplyParameterFromQuery] public int ReturnProgramId { get; set; }

    private PplSession? session;
    private bool loading = true;
    private bool savingSessionDate;
    private bool savingSessionNotes;
    private bool savingVoiceNotes;
    private DateTime sessionDate = DateTime.Today;
    private int restSeconds = 90;
    private int restRemaining;
    private Timer? restTimer;
    private Dictionary<(double Weight, double BarWeight), List<PlateLoadingResult>> plateMap = [];
    private Dictionary<int, Dictionary<int, PplPreviousSet>> previousSets = [];
    private Dictionary<int, IReadOnlyList<PplPreviousSet>> sameWeightHistory = [];

    /// <summary>Most recent earlier result for this set number at the set's current weight (any weight for bodyweight).</summary>
    private PplPreviousSet? FindSameWeightPrevious(PplSessionExercise exercise, int setNumber, double? weight)
    {
        if (!sameWeightHistory.TryGetValue(exercise.Id, out var history)) return null;
        if (exercise.EffectiveIsBodyweight)
            return history.Where(p => p.SetNumber == setNumber).MaxBy(p => p.OccurredOn);
        if (weight is not double w) return null;
        return history
            .Where(p => p.SetNumber == setNumber && p.Weight is double pw && Math.Abs(pw - w) < 0.01)
            .MaxBy(p => p.OccurredOn);
    }
    private string? setError;
    private string? exportError;
    private List<Bar> bars = [];
    private Bar? defaultBar;
    private int? barPickerExerciseId;
    private int? swapExerciseId;
    private List<ExerciseDefinition> swapOptions = [];
    private List<PplAccessorySwapOption> accessoryOptions = [];
    private string swapSelection = "";
    private bool swapping;
    private string? swapError;
    private int? confirmRemoveExerciseId;
    private bool addingExercise;
    private bool savingAddedExercise;
    private PplAddExerciseOptions addOptions = new([], []);
    private string addSelection = "";
    private int addSets = 3;
    private int addRepsMin = 10;
    private int addRepsMax = 15;
    private string? addError;

    private async Task OpenAddExercise()
    {
        addError = null;
        addOptions = await SwapService.GetAddExerciseOptionsAsync(SessionId);
        // Default to core work — the most common add-on.
        var first = addOptions.Exercises.FirstOrDefault(d => d.PrimaryMuscle == MuscleGroup.Core) ?? addOptions.Exercises.FirstOrDefault();
        addSelection = first is not null
            ? $"d:{first.Id}"
            : addOptions.Accessories.FirstOrDefault() is { } accessory ? $"a:{accessory.AccessoryId}" : "";
        addingExercise = true;
    }

    private void CloseAddExercise()
    {
        addingExercise = false;
        addOptions = new([], []);
        addError = null;
    }

    private async Task ConfirmAddExercise()
    {
        if (addSelection.Length < 3 || !int.TryParse(addSelection[2..], out var sourceId)) return;

        var source = addSelection.StartsWith("a:", StringComparison.Ordinal) ? PplAddExerciseSource.Accessory : PplAddExerciseSource.Library;
        savingAddedExercise = true;
        try
        {
            await SwapService.AddExerciseAsync(SessionId, new PplAddExerciseRequest(source, sourceId, addSets, addRepsMin, addRepsMax));
            CloseAddExercise();
            await LoadSession();
        }
        catch (InvalidOperationException ex)
        {
            addError = ex.Message;
        }
        finally
        {
            savingAddedExercise = false;
        }
    }

    private async Task RemoveAddedExercise(PplSessionExercise exercise)
    {
        setError = null;
        confirmRemoveExerciseId = null;
        try
        {
            await SwapService.RemoveAddedExerciseAsync(exercise.Id);
            await LoadSession();
        }
        catch (InvalidOperationException ex)
        {
            setError = ex.Message;
        }
    }

    private Bar BarFor(PplSessionExercise exercise) =>
        bars.FirstOrDefault(b => b.Id == exercise.BarId)
        ?? defaultBar
        ?? new Bar { Name = "Standard Olympic", Weight = 45 };

    private async Task OnExerciseBarSelected(PplSessionExercise exercise, ChangeEventArgs e)
    {
        int? barId = int.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;
        try
        {
            await SessionService.SetExerciseBarAsync(exercise.Id, barId);
            exercise.BarId = barId;
            if (exercise.ExerciseSlot is not null && !exercise.IsOneOffSwap)
                exercise.ExerciseSlot.BarId = barId;
            barPickerExerciseId = null;
            await BuildPlateMap();
        }
        catch (InvalidOperationException)
        {
            bars = await PlateCalc.GetBarsAsync();
            defaultBar = bars.FirstOrDefault(b => b.IsDefault) ?? bars.FirstOrDefault();
        }
    }

    private static string FormatAccessoryOption(PplAccessorySwapOption option) =>
        option.LastWeight is double weight
            ? $"{option.Name} — last {DisplayWeight(weight)} lbs × {option.LastReps}"
            : $"{option.Name} — no weight logged yet";

    private async Task OpenSwap(int sessionExerciseId)
    {
        swapError = null;
        swapOptions = await SwapService.GetSwapOptionsAsync(sessionExerciseId);
        accessoryOptions = await SwapService.GetAccessorySwapOptionsAsync(sessionExerciseId);
        swapSelection = swapOptions.FirstOrDefault() is { } first
            ? $"d:{first.Id}"
            : accessoryOptions.FirstOrDefault() is { } accessory ? $"a:{accessory.AccessoryId}" : "";
        swapExerciseId = sessionExerciseId;
    }

    private void CloseSwap()
    {
        swapExerciseId = null;
        swapOptions = [];
        accessoryOptions = [];
        swapError = null;
    }

    private async Task ConfirmSwap(PplSwapScope scope)
    {
        if (swapExerciseId is not int exerciseId || swapSelection.Length < 3
            || !int.TryParse(swapSelection[2..], out var targetId)) return;

        swapping = true;
        try
        {
            if (swapSelection.StartsWith("a:", StringComparison.Ordinal))
                await SwapService.SwapToAccessoryAsync(exerciseId, targetId, scope);
            else
                await SwapService.SwapAsync(exerciseId, targetId, scope);
            CloseSwap();
            await LoadSession();
        }
        catch (InvalidOperationException ex)
        {
            swapError = ex.Message;
        }
        finally
        {
            swapping = false;
        }
    }

    private int SetsTotal => session?.Exercises.Sum(e => e.Sets.Count) ?? 0;
    private int SetsDone  => session?.Exercises.Sum(e => e.Sets.Count(s => s.IsCompleted)) ?? 0;
    private int SetsPct   => SetsTotal > 0 ? (int)(SetsDone * 100.0 / SetsTotal) : 0;

    protected override async Task OnInitializedAsync()
    {
        // Load once the circuit is interactive; prerender shows the loading state instead of querying twice.
        if (!RendererInfo.IsInteractive) return;

        await LoadSession();
        loading = false;
    }

    private async Task LoadSession()
    {
        session = await SessionService.GetSessionWithDetailsAsync(SessionId);
        previousSets = session is null ? [] : await SessionService.GetPreviousSetsAsync(SessionId);
        sameWeightHistory = session is null ? [] : await SessionService.GetSameWeightPreviousSetsAsync(SessionId);
        if (session is not null)
        {
            restSeconds = Math.Clamp(session.RestSeconds, 0, 600);
            bars = await PlateCalc.GetBarsAsync();
            defaultBar = bars.FirstOrDefault(b => b.IsDefault) ?? bars.FirstOrDefault();
            await BuildPlateMap();
        }
    }

    private async Task BuildPlateMap()
    {
        if (session is null) return;
        var keys = session.Exercises
            .SelectMany(e => e.Sets.Select(s => s.ActualWeight ?? e.SuggestedWeight)
                .Append(e.SuggestedWeight)
                .Where(w => w.HasValue)
                .Select(w => (Weight: w!.Value, BarWeight: BarFor(e).Weight)))
            .Distinct();
        plateMap = [];
        foreach (var key in keys)
            plateMap[key] = await PlateCalc.CalculatePlates(key.Weight, key.BarWeight);
    }

    private async Task StartSession()
    {
        await SessionService.StartSessionAsync(SessionId);
        await LoadSession();
    }

    private async Task SaveSessionDate()
    {
        if (session is null) return;

        savingSessionDate = true;
        try
        {
            await SessionService.UpdateSessionDateAsync(session.Id, sessionDate);
            await LoadSession();
        }
        finally
        {
            savingSessionDate = false;
        }
    }

    private async Task SaveRestSeconds(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seconds))
        {
            restSeconds = Math.Clamp(seconds, 0, 600);
            await SessionService.UpdateRestSecondsAsync(SessionId, restSeconds);
        }
    }

    private async Task SaveSessionNotes()
    {
        if (session is null) return;

        savingSessionNotes = true;
        try
        {
            await SessionService.UpdateSessionNotesAsync(session.Id, session.Notes);
        }
        finally
        {
            savingSessionNotes = false;
        }
    }

    private async Task AppendVoiceNotes(string transcript)
    {
        if (session is null || string.IsNullOrWhiteSpace(transcript))
            return;

        var separator = string.IsNullOrWhiteSpace(session.Notes) ? string.Empty : " ";
        session.Notes = $"{session.Notes}{separator}{transcript}";

        savingVoiceNotes = true;
        try
        {
            await SessionService.UpdateSessionNotesAsync(session.Id, session.Notes);
        }
        finally
        {
            savingVoiceNotes = false;
        }
    }

    private async Task CompleteSession()
    {
        StopRestTimer();
        await SessionService.CompleteSessionAsync(SessionId);
        await LoadSession();
    }

    private async Task ReopenSession()
    {
        StopRestTimer();
        await SessionService.ReopenSessionAsync(SessionId);
        await LoadSession();
    }

    private async Task OnWeightChanged(PplSessionSet set, PplSessionExercise exercise, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var w) && PplSessionService.IsValidWeight(w))
        {
            var updatedIds = (await SessionService.UpdateSetWeightAsync(set.Id, w)).ToHashSet();
            foreach (var s in exercise.Sets.Where(s => updatedIds.Contains(s.Id)))
                s.ActualWeight = w;
            if (!exercise.SuggestedWeight.HasValue && !exercise.EffectiveIsBodyweight
                && exercise.ExerciseSlot is not null && exercise.PplExerciseSlotId is int slotId && !exercise.IsOneOffSwap)
            {
                await SessionService.SetStartingWeightAsync(slotId, w);
                exercise.ExerciseSlot.StartingWeight ??= w;
                exercise.ExerciseSlot.CurrentWeight ??= w;
            }
            await BuildPlateMap();
            await AutoStart();
        }
    }

    private async Task OnRepsChanged(PplSessionSet set, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var r) && PplSessionService.IsValidReps(r))
        {
            set.ActualReps = r;
            await SessionService.UpdateSetAsync(set.Id, set.ActualWeight, set.ActualReps, set.IsCompleted);
            await AutoStart();
        }
    }

    private async Task ToggleSet(PplSessionSet set, PplSessionExercise exercise)
    {
        var wasCompleted = set.IsCompleted;
        set.IsCompleted = !set.IsCompleted;
        if (set.IsCompleted)
        {
            set.ActualWeight ??= exercise.SuggestedWeight;
            set.ActualReps   ??= set.TargetReps;
        }
        await SessionService.UpdateSetAsync(set.Id, set.ActualWeight, set.ActualReps, set.IsCompleted);
        await AutoStart();
        if (!wasCompleted && set.IsCompleted)
            StartRestTimer();
    }

    private void StartRestTimer()
    {
        StopRestTimer();
        restRemaining = restSeconds;
        if (restRemaining <= 0) return;
        restTimer = new Timer(async _ => await TickRestTimer(), null, 1000, 1000);
    }

    private async Task TickRestTimer()
    {
        await InvokeAsync(() =>
        {
            if (restRemaining <= 1)
            {
                restRemaining = 0;
                StopRestTimer();
            }
            else
            {
                restRemaining--;
            }
            StateHasChanged();
        });
    }

    private void StopRestTimer()
    {
        restTimer?.Dispose();
        restTimer = null;
        restRemaining = 0;
    }

    private static string FormatRest(int seconds) => $"{seconds / 60}:{seconds % 60:D2}";

    public ValueTask DisposeAsync()
    {
        StopRestTimer();
        return ValueTask.CompletedTask;
    }

    private async Task RemoveSet(PplSessionSet set)
    {
        setError = null;
        try
        {
            if (await SessionService.RemoveSetAsync(set.Id))
                await LoadSession();
        }
        catch (InvalidOperationException ex)
        {
            setError = ex.Message;
        }
    }

    private async Task AddSet(PplSessionExercise exercise)
    {
        setError = null;
        try
        {
            if (await SessionService.AddSetAsync(exercise.Id) is not null)
                await LoadSession();
        }
        catch (InvalidOperationException ex)
        {
            setError = ex.Message;
        }
    }

    private async Task AutoStart()
    {
        if (session?.Status == WorkoutStatus.NotStarted)
        {
            await SessionService.StartSessionAsync(SessionId);
            session.Status = WorkoutStatus.InProgress;
        }
    }

    private static string GetStatusBadgeClass(WorkoutStatus s) => s switch
    {
        WorkoutStatus.NotStarted => "badge-muted",
        WorkoutStatus.InProgress => "badge-warning",
        WorkoutStatus.Completed  => "badge-success",
        _ => "badge-muted"
    };

    private static string DisplayWeight(double? weight) => weight?.ToString("0.##") ?? "—";

    private static string GetStatusLabel(WorkoutStatus s) => s switch
    {
        WorkoutStatus.NotStarted => "Not Started",
        WorkoutStatus.InProgress => "In Progress",
        WorkoutStatus.Completed  => "Completed",
        _ => ""
    };

    private static string GetDayTypeBadge(PplDayType t) => t switch
    {
        PplDayType.Push => "badge-push",
        PplDayType.Pull => "badge-pull",
        PplDayType.Legs => "badge-legs",
        _ => "badge-muted"
    };

    private static string GetMuscleGroupBadge(MuscleGroup mg) => mg switch
    {
        MuscleGroup.Chest or MuscleGroup.Triceps or MuscleGroup.Shoulders => "badge-push",
        MuscleGroup.Back  or MuscleGroup.Biceps  or MuscleGroup.RearDelts => "badge-pull",
        _ => "badge-legs"
    };

    private static string FormatPlate(double w) =>
        w == (int)w ? ((int)w).ToString() : w.ToString("0.#");

}
