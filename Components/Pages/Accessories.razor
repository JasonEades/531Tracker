@page "/accessories"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAccessoryService AccessoryService
@inject ICurrentUserService CurrentUserService

<PageTitle>Accessories — 5/3/1 Tracker</PageTitle>

<div class="page-header animate-fade-in">
    <div>
        <h1>Accessories</h1>
        <p class="page-subtitle">Exercise library used in your workouts</p>
    </div>
    @if (!showForm)
    {
        <button class="btn btn-primary" @onclick="ShowAdd">+ Add Accessory</button>
    }
</div>

@* ── Add / Edit form ──────────────────────────────────────── *@
@if (showForm)
{
    <div class="setup-sheet animate-slide-up mb-4">
        <div class="setup-sheet-header">
            <h3>@(editingId.HasValue ? "Edit" : "New") Accessory</h3>
            <button class="btn btn-ghost btn-sm" @onclick="CancelForm">✕</button>
        </div>

        <div class="form-group">
            <label class="form-label">Exercise Name</label>
            <input type="text" class="form-control" @bind="formName"
                   placeholder="e.g. Barbell Row" autofocus />
        </div>
        <div class="form-group">
            <label class="form-label">Description (optional)</label>
            <input type="text" class="form-control" @bind="formDescription"
                   placeholder="Brief description" />
        </div>
        @if (editingId.HasValue)
        {
            <div class="form-group">
                <label class="toggle-row">
                    <span class="form-label" style="margin-bottom:0">Active</span>
                    <input type="checkbox" @bind="formActive" />
                </label>
            </div>
        }
        <div class="flex gap-2 mt-2">
            <button class="btn btn-primary flex-1" @onclick="SaveAccessory"
                    disabled="@string.IsNullOrWhiteSpace(formName)">
                Save
            </button>
            <button class="btn btn-outline" @onclick="CancelForm">Cancel</button>
        </div>
    </div>
}

@* ── List ─────────────────────────────────────────────────── *@
@if (loading)
{
    <div class="loading"><div class="spinner"></div></div>
}
else if (accessories.Count == 0 && !showForm)
{
    <div class="empty-state">
        <div class="empty-state-icon">💪</div>
        <h3>No Accessories Yet</h3>
        <p>Add exercises to your library to track alongside your main lifts.</p>
        <button class="btn btn-primary mt-2" @onclick="ShowAdd">+ Add Accessory</button>
    </div>
}
else
{
    <div class="acc-library animate-fade-in">
        @foreach (var acc in accessories)
        {
            <div class="acc-library-row @(acc.IsActive ? "" : "acc-inactive")">
                <div class="acc-library-info">
                    <div class="acc-library-name">
                        @acc.Name
                        @if (!acc.IsActive)
                        {
                            <span class="badge badge-muted ml-1">Inactive</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(acc.Description))
                    {
                        <div class="acc-library-desc">@acc.Description</div>
                    }
                </div>
                <div class="acc-library-right">
                    @if (lastWeights.TryGetValue(acc.Id, out var w))
                    {
                        <span class="acc-last-weight">@w <span style="font-size:var(--text-xs);font-weight:400">lbs</span></span>
                    }
                    <div class="acc-library-actions">
                        @if (acc.UserId == currentUserId)
                        {
                            <button class="btn btn-ghost btn-sm acc-action-btn"
                                    @onclick="() => EditAccessory(acc)"
                                    title="Edit">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="btn btn-sm acc-action-btn acc-delete-btn"
                                    @onclick="() => DeleteAccessory(acc.Id)"
                                    title="Delete">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ── FAB ─────────────────────────────────────────────────── *@
@if (!showForm)
{
    <button class="fab" @onclick="ShowAdd" title="Add Accessory" aria-label="Add Accessory">+</button>
}

@code {
    private List<Accessory> accessories = [];
    private Dictionary<int, double> lastWeights = new();
    private string? currentUserId;
    private bool loading = true;
    private bool showForm;
    private int? editingId;
    private string formName = "";
    private string? formDescription;
    private bool formActive = true;

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await CurrentUserService.GetUserIdOrNullAsync();
        await LoadAccessories();
        loading = false;
    }

    private async Task LoadAccessories()
    {
        accessories = await AccessoryService.GetAllAccessoriesAsync();
        lastWeights.Clear();
        foreach (var acc in accessories)
        {
            var suggested = await AccessoryService.GetSuggestedWeightAsync(acc.Id);
            if (suggested.HasValue)
                lastWeights[acc.Id] = suggested.Value;
        }
    }

    private void ShowAdd()
    {
        editingId       = null;
        formName        = "";
        formDescription = null;
        formActive      = true;
        showForm        = true;
    }

    private void EditAccessory(Accessory acc)
    {
        editingId       = acc.Id;
        formName        = acc.Name;
        formDescription = acc.Description;
        formActive      = acc.IsActive;
        showForm        = true;
    }

    private async Task SaveAccessory()
    {
        if (string.IsNullOrWhiteSpace(formName)) return;
        if (editingId.HasValue)
            await AccessoryService.UpdateAccessoryAsync(editingId.Value, formName.Trim(), formDescription?.Trim(), formActive);
        else
            await AccessoryService.CreateAccessoryAsync(formName.Trim(), formDescription?.Trim());
        CancelForm();
        await LoadAccessories();
    }

    private async Task DeleteAccessory(int id)
    {
        await AccessoryService.DeleteAccessoryAsync(id);
        await LoadAccessories();
    }

    private void CancelForm()
    {
        showForm        = false;
        editingId       = null;
        formName        = "";
        formDescription = null;
    }
}
