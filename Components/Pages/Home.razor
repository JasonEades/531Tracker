@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICycleService CycleService
@inject ILiftService LiftService
@inject IPplProgramService PplProgramService
@inject IPplSessionService PplSessionService
@inject IUserInitService UserInitService
@inject ICurrentUserService UserContext
@inject NavigationManager Nav

<PageTitle>Dashboard — 5/3/1 Tracker</PageTitle>

@if (loading)
{
    <div class="loading">
        <div class="spinner"></div>
    </div>
}
else if (currentCycle is null && activePplProgram is null)
{
    @* ── Combined empty / get-started state ─────────────────── *@
    <div class="empty-state animate-fade-in">
        <div class="empty-state-icon">🏋️</div>
        <h3>Ready to get strong?</h3>
        <p>Choose a program to get started.</p>
        <div class="program-choice-grid mt-3">
            <button class="program-choice-btn" @onclick="() => showSetup = true">
                <span class="program-choice-icon">5/3/1</span>
                <span class="program-choice-name">5/3/1 Powerlifting</span>
                <span class="program-choice-hint">4 barbell lifts · percentage-based · 4-week cycles</span>
            </button>
            <button class="program-choice-btn" @onclick='() => Nav.NavigateTo("/ppl/new")'>
                <span class="program-choice-icon">PPL</span>
                <span class="program-choice-name">Push / Pull / Legs</span>
                <span class="program-choice-hint">6 muscle groups · double progression · 3 or 6 days</span>
            </button>
        </div>
    </div>

    @if (showSetup)
    {
        <div class="setup-sheet animate-slide-up">
            <div class="setup-sheet-header">
                <h3>New Cycle Setup</h3>
                <button class="btn btn-ghost btn-sm" @onclick="() => showSetup = false">✕</button>
            </div>

            <div class="form-group">
                <label class="toggle-row">
                    <span class="form-label" style="margin-bottom:0">Boring But Big — BBB (5×10)</span>
                    <input type="checkbox" @bind="enableBbb" />
                </label>
                <p class="option-hint">After your main sets, do <strong>5 sets of 10 reps</strong> at a lighter weight (default 50% of your Training Max). Builds serious size and work capacity. Best for intermediate lifters comfortable with the base program.</p>
            </div>

            <div class="form-group">
                <label class="toggle-row">
                    <span class="form-label" style="margin-bottom:0">Warmup Sets (2×5)</span>
                    <input type="checkbox" @bind="enableWarmup" />
                </label>
                <p class="option-hint">Adds two light warm-up sets (40% and 50% of your Training Max) before each main lift to get your joints and nervous system ready. Recommended for most lifters.</p>
            </div>

            <div class="form-group">
                <label class="toggle-row">
                    <span class="form-label" style="margin-bottom:0">5s PRO</span>
                    <input type="checkbox" @bind="enableFivesPro" />
                </label>
                <p class="option-hint">All main sets are capped at <strong>5 straight reps</strong> — no max-effort sets. Normal 5/3/1 asks you to do as many reps as possible (<strong>AMRAP</strong>) on the last set; 5s PRO removes that to keep intensity lower and volume higher. Great for building a base before a heavier cycle.</p>
            </div>

            <div class="form-group">
                <label class="toggle-row">
                    <span class="form-label" style="margin-bottom:0">First Set Last — FSL (5×5)</span>
                    <input type="checkbox" @bind="enableFsl" />
                </label>
                <p class="option-hint">After your main sets, cycle back and do <strong>5 sets of 5 reps</strong> at the weight you used for your very first main set (the lightest of the three). Lower intensity than BBB but higher rep quality. Works well paired with 5s PRO.</p>
            </div>

            @if (enableBbb)
            {
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">BBB Lift Pairing</label>
                        <select class="form-control" @bind="selectedBbbMode">
                            <option value="@BbbMode.OppositeDay">Opposite Day</option>
                            <option value="@BbbMode.SameDay">Same Day</option>
                        </select>
                        <p class="option-hint"><strong>Opposite Day</strong> — Bench BBB on Press day, Squat BBB on Deadlift day (and vice versa). <strong>Same Day</strong> — BBB uses the same lift you just trained.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">BBB % of Training Max</label>
                        <select class="form-control" @bind="selectedBbbPct">
                            @foreach (var pct in new[] { 30, 35, 40, 45, 50, 55, 60, 65, 70 })
                            {
                                <option value="@pct">@pct%</option>
                            }
                        </select>
                        <p class="option-hint">The weight used for all 5×10 sets, as a percentage of your Training Max. <strong>50%</strong> is the standard starting point. Go lower if you're newer to BBB.</p>
                    </div>
                </div>
            }

            <div class="flex gap-1 mt-2">
                <button class="btn btn-primary flex-1" @onclick="CreateFirstCycle" disabled="@loading">
                    🚀 Create Cycle
                </button>
                <button class="btn btn-outline" @onclick="() => showSetup = false">Cancel</button>
            </div>
        </div>
    }
}
else
{
    @* -- PPL Hero -- *@
    @if (activePplProgram is not null)
    {
        <div class="ppl-hero-card animate-fade-in mb-4">
            <div class="ppl-hero-top">
                <div>
                    <div class="hero-subtitle">TODAYS PPL SESSION</div>
                    @if (nextPplSession is not null)
                    {
                        <div class="hero-title">@nextPplSession.DayTemplate.Name</div>
                        <div class="hero-meta">
                            @activePplProgram.Name
                            <span class="badge @GetDayTypeBadge(nextPplSession.DayTemplate.DayType) ml-1">@nextPplSession.DayTemplate.DayType</span>
                        </div>
                    }
                    else
                    {
                        <div class="hero-title">Rotation complete!</div>
                        <div class="hero-meta">@activePplProgram.Name - Start next round</div>
                    }
                </div>
                <div class="ppl-hero-badge">PPL</div>
            </div>
            <button class="btn btn-ppl btn-full mt-3" @onclick="StartNextPplSession">
                Start PPL Session
            </button>
        </div>
    }

    @* -- 531 Hero -- *@
    @if (currentCycle is not null)
    {
    <div class="hero-card animate-fade-in">
        <div class="flex items-center justify-between mb-2">
            <div>
                <div class="hero-subtitle">CURRENT CYCLE</div>
                <div class="hero-title">@currentCycle.Name</div>
                <div class="hero-meta">@currentWeekDisplay · @completedWorkouts of @totalWorkouts workouts complete</div>
            </div>
            <div class="progress-ring-wrap">
                <svg class="progress-ring-svg" width="72" height="72" viewBox="0 0 72 72">
                    <defs>
                        <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#5E7CFF"/>
                            <stop offset="100%" stop-color="#6EE7FF"/>
                        </linearGradient>
                    </defs>
                    <circle cx="36" cy="36" r="30" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="6"/>
                    <circle cx="36" cy="36" r="30" fill="none"
                            stroke="url(#ringGrad)"
                            stroke-width="6"
                            stroke-linecap="round"
                            stroke-dasharray="@(2 * Math.PI * 30)"
                            stroke-dashoffset="@(2 * Math.PI * 30 * (1 - progressPercent / 100.0))"
                            transform="rotate(-90 36 36)"/>
                    <text x="36" y="40" text-anchor="middle" font-size="14" font-weight="700" fill="white">@progressPercent%</text>
                </svg>
            </div>
        </div>

        <button class="btn btn-primary btn-full mt-3" @onclick="GoToCycle">
            View Current Cycle
        </button>
    </div>

    @* ── Progress strip ─────────────────────────────────── *@
    <div class="progress-strip mb-3">
        <div class="flex items-center justify-between mb-1">
            <span class="text-muted" style="font-size:var(--text-xs);font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Cycle Progress</span>
            <span class="text-muted" style="font-size:var(--text-xs)">@completedWorkouts / @totalWorkouts workouts</span>
        </div>
        <div class="progress-bar-wrapper">
            <div class="progress-bar-fill" style="width: @progressPercent%"></div>
        </div>
    </div>

    @* ── Stat cards ─────────────────────────────────────── *@
    <div class="stats-grid">
        <div class="stat-card animate-scale-in">
            <div class="stat-label">Current Week</div>
            <div class="stat-value">@currentWeekDisplay</div>
        </div>
        <div class="stat-card animate-scale-in">
            <div class="stat-label">Completion</div>
            <div class="stat-value">@progressPercent<span style="font-size:var(--text-lg)">%</span></div>
        </div>
        @foreach (var lift in lifts.Take(2))
        {
            <div class="stat-card animate-scale-in">
                <div class="stat-label">@lift.Name TM</div>
                <div class="stat-value">@lift.TrainingMax<span style="font-size:var(--text-sm);font-weight:400;color:var(--color-text-muted)"> lbs</span></div>
            </div>
        }
    </div>

    @* ── Training Maxes ─────────────────────────────────── *@
    @if (lifts.Count > 0)
    {
        <div class="card mb-3 animate-fade-in">
            <div class="card-header">Training Maxes</div>
            <div class="card-body" style="padding:0">
                @foreach (var lift in lifts)
                {
                    <div class="tm-row">
                        <div class="tm-lift">@lift.Name</div>
                        <div class="tm-weight">@lift.TrainingMax <span class="tm-unit">lbs</span></div>
                        @if (lift.BbbPercentage > 0)
                        {
                            <div class="tm-bbb">BBB @lift.BbbPercentage%</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ── Upcoming workouts ──────────────────────────────── *@
    @if (upcomingWorkouts.Count > 0)
    {
        <div class="section-header">
            <h3>Upcoming</h3>
        </div>
        <div class="week-grid animate-fade-in">
            @foreach (var wo in upcomingWorkouts)
            {
                <button class="workout-item" @onclick="() => GoToWorkout(wo.Id)">
                    <div class="flex items-center gap-2">
                        <span class="status-dot @GetStatusClass(wo.Status)"></span>
                        <div>
                            <div class="workout-name">@GetLiftDisplayName(wo.MainLiftType)</div>
                            <div class="workout-meta">Week @((int)wo.Week.WeekNumber) · @GetWeekLabel(wo.Week.WeekNumber)</div>
                        </div>
                    </div>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-text-muted);flex-shrink:0"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            }
        </div>
    }
    } @* end @if currentCycle *@
}

@code {
    private Cycle? currentCycle;
    private List<Lift> lifts = [];
    private List<Workout> upcomingWorkouts = [];
    private PplProgram? activePplProgram;
    private PplSession? nextPplSession;
    private bool loading = true;
    private bool showSetup;
    private bool enableBbb;
    private bool enableWarmup;
    private bool enableFivesPro;
    private bool enableFsl;
    private BbbMode selectedBbbMode = BbbMode.OppositeDay;
    private double selectedBbbPct = 50;

    private int totalWorkouts;
    private int completedWorkouts;
    private int progressPercent;
    private string currentWeekDisplay = "-";

    protected override async Task OnInitializedAsync()
    {
        var userId = await UserContext.GetUserIdOrNullAsync();
        if (userId is not null)
            await UserInitService.EnsureUserInitializedAsync(userId);
        await LoadData();
        loading = false;
    }

    private async Task LoadData()
    {
        currentCycle = await CycleService.GetCurrentCycleAsync();
        lifts = await LiftService.GetAllLiftsAsync();
        activePplProgram = await PplProgramService.GetActiveProgramAsync();
        if (activePplProgram is not null)
        {
            try { nextPplSession = await PplProgramService.GetOrCreateNextSessionAsync(activePplProgram.Id); }
            catch { nextPplSession = null; }
        }

        if (currentCycle is not null)
        {
            var allWorkouts = currentCycle.Weeks.SelectMany(w => w.Workouts).ToList();
            totalWorkouts = allWorkouts.Count;
            completedWorkouts = allWorkouts.Count(w => w.Status == WorkoutStatus.Completed);
            progressPercent = totalWorkouts > 0 ? (int)(completedWorkouts * 100.0 / totalWorkouts) : 0;

            var activeWeek = currentCycle.Weeks
                .OrderBy(w => w.WeekNumber)
                .FirstOrDefault(w => w.Workouts.Any(wo => wo.Status != WorkoutStatus.Completed));
            currentWeekDisplay = activeWeek is not null
                ? $"Week {(int)activeWeek.WeekNumber}"
                : "Done";

            upcomingWorkouts = allWorkouts
                .Where(w => w.Status != WorkoutStatus.Completed)
                .OrderBy(w => w.Week.WeekNumber).ThenBy(w => w.MainLiftType)
                .Take(6)
                .ToList();
        }
    }

    private async Task CreateFirstCycle()
    {
        loading = true;
        var mode = enableBbb ? selectedBbbMode : BbbMode.None;
        await CycleService.CreateCycleAsync(mode, selectedBbbPct, enableWarmup, enableFivesPro, enableFsl);
        showSetup = false;
        await LoadData();
        loading = false;
    }

    private async Task StartNextPplSession()
    {
        if (activePplProgram is null) return;
        var session = await PplProgramService.GetOrCreateNextSessionAsync(activePplProgram.Id);
        Nav.NavigateTo($"/ppl/session/{session.Id}");
    }

    private void GoToWorkout(int id) => Nav.NavigateTo("/workout/" + id);

    private void GoToCycle()
    {
        if (currentCycle is not null)
            Nav.NavigateTo("/cycles/" + currentCycle.Id);
    }

    private static string GetLiftDisplayName(LiftType lt) => lt switch
    {
        LiftType.Squat       => "Squat",
        LiftType.BenchPress  => "Bench Press",
        LiftType.Deadlift    => "Deadlift",
        LiftType.OverheadPress => "Overhead Press",
        _                    => lt.ToString()
    };

    private static string GetWeekLabel(WeekNumber wn) => wn switch
    {
        WeekNumber.Week1 => "5s",
        WeekNumber.Week2 => "3s",
        WeekNumber.Week3 => "5/3/1",
        WeekNumber.Week4 => "Deload",
        _                => ""
    };

    private static string GetStatusClass(WorkoutStatus s) => s switch
    {
        WorkoutStatus.Completed  => "status-completed",
        WorkoutStatus.InProgress => "status-in-progress",
        _                        => "status-not-started",
    };

    private static string GetDayTypeBadge(PplDayType t) => t switch
    {
        PplDayType.Push => "badge-push",
        PplDayType.Pull => "badge-pull",
        PplDayType.Legs => "badge-legs",
        _ => "badge-muted"
    };
}
