@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using FiveThreeOneTracker.Data
@using FiveThreeOneTracker.Models
@inject ICycleService CycleService
@inject ILiftService LiftService
@inject IPplProgramService PplProgramService
@inject IPplSessionService PplSessionService
@inject IUserInitService UserInitService
@inject ICurrentUserService UserContext
@inject IDashboardAnalyticsService DashboardAnalyticsService
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Dashboard — Jason's Garage Lab</PageTitle>

@if (!loading && (recentReview is not null || recentBlogPost is not null))
{
    <div class="dashboard-content-features">
        @foreach (var featureType in new[] { SiteContentType.ProductReview, SiteContentType.BlogPost })
        {
            var item = featureType == SiteContentType.ProductReview ? recentReview : recentBlogPost;
            var itemTypeLabel = featureType == SiteContentType.ProductReview ? "Product review" : "Blog post";
            if (item is null)
            {
                <div class="dashboard-blog-feature dashboard-blog-feature-empty">
                    <span class="dashboard-blog-feature-copy">
                        <span class="dashboard-blog-feature-label">LATEST · @itemTypeLabel.ToUpperInvariant()</span>
                        <span class="dashboard-blog-feature-caption">No published @(featureType == SiteContentType.ProductReview ? "reviews" : "posts") yet.</span>
                    </span>
                </div>
                continue;
            }

            var itemUrl = $"/{(item.Type == SiteContentType.ProductReview ? "reviews" : "blog")}/{Uri.EscapeDataString(item.Slug)}";
            <a class="dashboard-blog-feature" href="@itemUrl" aria-label="@($"Read {itemTypeLabel}: {item.Title}")">
                <img src="@(item.FeaturedImageUrl ?? "images/baselogo-192.png")"
                     alt="@(item.FeaturedImageCaption ?? item.Title)"
                     class="dashboard-blog-feature-image" />
                <span class="dashboard-blog-feature-copy">
                    <span class="dashboard-blog-feature-label">LATEST · @itemTypeLabel.ToUpperInvariant()</span>
                    <span class="dashboard-blog-feature-title">@item.Title</span>
                    @if (item.Type == SiteContentType.ProductReview && item.Rating is int rating)
                    {
                        <span class="dashboard-blog-feature-rating" aria-label="@($"{rating} out of 5 stars")">
                            <span aria-hidden="true">@RatingStars(rating)</span>
                            <span>@rating/5</span>
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.FeaturedImageCaption))
                    {
                        <span class="dashboard-blog-feature-caption">@item.FeaturedImageCaption</span>
                    }
                </span>
            </a>
        }
    </div>
}

@if (loading)
{
    <div class="loading">
        <div class="spinner"></div>
    </div>
}
else if (currentCycle is null && activePplProgram is null)
{
    @* ── Combined empty / get-started state ─────────────────── *@
    <div class="empty-state">
        <h3>No active program</h3>
        <p>Pick a program to set up your training maxes and first week.</p>
        <div class="program-choice-grid mt-3">
            <button class="program-choice-btn" @onclick="() => showSetup = true">
                <span class="program-choice-icon">5/3/1</span>
                <span class="program-choice-name">5/3/1 Powerlifting</span>
                <span class="program-choice-hint">4 barbell lifts · percentage-based · 4-week cycles</span>
            </button>
            <button class="program-choice-btn" @onclick='() => Nav.NavigateTo("/ppl/new")'>
                <span class="program-choice-icon">PPL</span>
                <span class="program-choice-name">Push / Pull / Legs</span>
                <span class="program-choice-hint">6 muscle groups · you set the weights · 3 or 6 days</span>
            </button>
        </div>
    </div>

    @if (showSetup)
    {
        <div class="setup-sheet">
            <div class="setup-sheet-header">
                <h3>New Cycle Setup</h3>
                <button class="btn btn-ghost btn-sm" @onclick="() => showSetup = false">✕</button>
            </div>

            <div class="form-group">
                <label class="toggle-row">
                    <span class="form-label" style="margin-bottom:0">Boring But Big — BBB (5×10)</span>
                    <input type="checkbox" @bind="enableBbb" />
                </label>
                <p class="option-hint">After your main sets, do <strong>5 sets of 10 reps</strong> at a lighter weight (default 50% of your Training Max). Builds serious size and work capacity. Best for intermediate lifters comfortable with the base program.</p>
            </div>

            <div class="form-group">
                <label class="toggle-row">
                    <span class="form-label" style="margin-bottom:0">Warmup Sets (2×5)</span>
                    <input type="checkbox" @bind="enableWarmup" />
                </label>
                <p class="option-hint">Adds two light warm-up sets (40% and 50% of your Training Max) before each main lift to get your joints and nervous system ready. Recommended for most lifters.</p>
            </div>

            <div class="form-group">
                <label class="toggle-row">
                    <span class="form-label" style="margin-bottom:0">5s PRO</span>
                    <input type="checkbox" @bind="enableFivesPro" />
                </label>
                <p class="option-hint">All main sets are capped at <strong>5 straight reps</strong> — no max-effort sets. Normal 5/3/1 asks you to do as many reps as possible (<strong>AMRAP</strong>) on the last set; 5s PRO removes that to keep intensity lower and volume higher. Great for building a base before a heavier cycle.</p>
            </div>

            <div class="form-group">
                <label class="toggle-row">
                    <span class="form-label" style="margin-bottom:0">First Set Last — FSL (5×5)</span>
                    <input type="checkbox" @bind="enableFsl" />
                </label>
                <p class="option-hint">After your main sets, cycle back and do <strong>5 sets of 5 reps</strong> at the weight you used for your very first main set (the lightest of the three). Lower intensity than BBB but higher rep quality. Works well paired with 5s PRO.</p>
            </div>

            @if (enableBbb)
            {
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">BBB Lift Pairing</label>
                        <select class="form-control" @bind="selectedBbbMode">
                            <option value="@BbbMode.OppositeDay">Opposite Day</option>
                            <option value="@BbbMode.SameDay">Same Day</option>
                        </select>
                        <p class="option-hint"><strong>Opposite Day</strong> — Bench BBB on Press day, Squat BBB on Deadlift day (and vice versa). <strong>Same Day</strong> — BBB uses the same lift you just trained.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">BBB % of Training Max</label>
                        <select class="form-control" @bind="selectedBbbPct">
                            @foreach (var pct in new[] { 30, 35, 40, 45, 50, 55, 60, 65, 70 })
                            {
                                <option value="@pct">@pct%</option>
                            }
                        </select>
                        <p class="option-hint">The weight used for all 5×10 sets, as a percentage of your Training Max. <strong>50%</strong> is the standard starting point. Go lower if you're newer to BBB.</p>
                    </div>
                </div>
            }

            <div class="flex gap-1 mt-2">
                <button class="btn btn-primary flex-1" @onclick="CreateFirstCycle" disabled="@loading">
                    Create Cycle
                </button>
                <button class="btn btn-outline" @onclick="() => showSetup = false">Cancel</button>
            </div>
        </div>
    }
}
else
{
    @if (activePplProgram is not null && currentCycle is not null)
    {
        <div class="section-header">
            <h3>Active Programs</h3>
        </div>
    }

    @* -- PPL Hero -- *@
    @if (activePplProgram is not null)
    {
        var suggestedDay = pplWeekPlan?.Suggested;
        <div class="ppl-hero-card mb-4">
            <div class="ppl-hero-top">
                <div>
                    <div class="hero-subtitle">ACTIVE PPL PROGRAM</div>
                    @if (suggestedDay is not null)
                    {
                        <div class="hero-title">@suggestedDay.Name</div>
                        <div class="hero-meta">
                            @activePplProgram.Name · Week @pplWeekPlan!.WeekNumber · @pplWeekPlan.Days.Count(d => d.State == PplDayState.Completed) of @pplWeekPlan.Days.Count done
                            <span class="badge @GetDayTypeBadge(suggestedDay.DayType) ml-1">@suggestedDay.DayType</span>
                        </div>
                    }
                    else
                    {
                        <div class="hero-title">Week complete</div>
                        <div class="hero-meta">@activePplProgram.Name · Next week starts with your next session</div>
                    }
                </div>
                <div class="ppl-hero-badge">PPL</div>
            </div>

            @if (pplWeekPlan is not null)
            {
                <div class="ppl-week-days" role="list" aria-label="This week's PPL workouts">
                    @foreach (var day in pplWeekPlan.Days)
                    {
                        var isSuggested = day.DayTemplateId == pplWeekPlan.SuggestedDayTemplateId;
                        <button role="listitem"
                                class="ppl-week-day @(day.State == PplDayState.Completed ? "done" : "") @(isSuggested ? "next" : "")"
                                disabled="@pplStarting"
                                @onclick="() => OpenPplDay(day)">
                            <span class="badge @GetDayTypeBadge(day.DayType)">@day.DayType</span>
                            <span class="ppl-week-day-name">@day.Name</span>
                            <span class="ppl-week-day-state">@GetPplDayStateLabel(day, isSuggested)</span>
                        </button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(pplError))
                {
                    <div class="alert alert-danger mt-2">@pplError</div>
                }
            }

            <button class="btn btn-ppl btn-full mt-3" @onclick="StartNextPplSession" disabled="@pplStarting">
                @(pplWeekPlan?.OpenDay is { } openDay ? $"Continue {openDay.Name}" : suggestedDay is not null ? $"Start {suggestedDay.Name}" : "Start Next Week")
            </button>
            <button class="btn btn-outline btn-full mt-2" @onclick='() => Nav.NavigateTo($"/ppl/{activePplProgram.Id}/workouts")'>
                Configure Weekly Workouts
            </button>
        </div>
    }

    @* -- 531 Hero -- *@
    @if (currentCycle is not null)
    {
    <div class="hero-card">
        <div class="flex items-center justify-between mb-2">
            <div>
                <div class="hero-subtitle">CURRENT CYCLE</div>
                <div class="hero-title">@currentCycle.Name</div>
                <div class="hero-meta">@currentWeekDisplay · @completedWorkouts of @totalWorkouts workouts complete</div>
            </div>
            <div class="progress-ring-wrap">
                <svg class="progress-ring-svg" width="72" height="72" viewBox="0 0 72 72" role="img" aria-label="@progressPercent% of cycle complete">
                    <circle class="progress-ring-track" cx="36" cy="36" r="30" fill="none" stroke-width="5"/>
                    <circle class="progress-ring-value" cx="36" cy="36" r="30" fill="none"
                            stroke-width="5"
                            stroke-linecap="butt"
                            stroke-dasharray="@(2 * Math.PI * 30)"
                            stroke-dashoffset="@(2 * Math.PI * 30 * (1 - progressPercent / 100.0))"
                            transform="rotate(-90 36 36)"/>
                    <text class="progress-ring-label" x="36" y="42" text-anchor="middle">@progressPercent%</text>
                </svg>
            </div>
        </div>

        <button class="btn btn-primary btn-full mt-3" @onclick="GoToCycle">
            Open 5/3/1 Cycle
        </button>
    </div>

    @* ── Progress strip ─────────────────────────────────── *@
    <div class="progress-strip mb-3">
        <div class="flex items-center justify-between mb-1">
            <span class="text-muted" style="font-size:var(--text-xs);font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Cycle Progress</span>
            <span class="text-muted" style="font-size:var(--text-xs)">@completedWorkouts / @totalWorkouts workouts</span>
        </div>
        <div class="progress-bar-wrapper">
            <div class="progress-bar-fill" style="width: @progressPercent%"></div>
        </div>
    </div>

    @* ── Stat cards ─────────────────────────────────────── *@
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Current Week</div>
            <div class="stat-value">@currentWeekDisplay</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Completion</div>
            <div class="stat-value">@progressPercent<span style="font-size:var(--text-lg)">%</span></div>
        </div>
        @foreach (var lift in lifts.Take(2))
        {
            <div class="stat-card">
                <div class="stat-label">@lift.Name TM</div>
                <div class="stat-value">@lift.TrainingMax<span style="font-size:var(--text-sm);font-weight:400;color:var(--color-text-muted)"> lbs</span></div>
            </div>
        }
    </div>

    @* ── Training Maxes ─────────────────────────────────── *@
    @if (lifts.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">Training Maxes</div>
            <div class="card-body" style="padding:0">
                @foreach (var lift in lifts)
                {
                    <div class="tm-row">
                        <div class="tm-lift">@lift.Name</div>
                        <div class="tm-weight">@lift.TrainingMax <span class="tm-unit">lbs</span></div>
                        @if (lift.BbbPercentage > 0)
                        {
                            <div class="tm-bbb">BBB @lift.BbbPercentage%</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ── Upcoming workouts ──────────────────────────────── *@
    @if (upcomingWorkouts.Count > 0)
    {
        <div class="section-header">
            <h3>Upcoming</h3>
        </div>
        <div class="week-grid">
            @foreach (var wo in upcomingWorkouts)
            {
                <button class="workout-item" @onclick="() => GoToWorkout(wo.Id)">
                    <div class="flex items-center gap-2">
                        <span class="status-dot @GetStatusClass(wo.Status)"></span>
                        <div>
                            <div class="workout-name">@GetLiftDisplayName(wo.MainLiftType)</div>
                            <div class="workout-meta">Week @((int)wo.Week.WeekNumber) · @GetWeekLabel(wo.Week.WeekNumber)</div>
                        </div>
                    </div>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-text-muted);flex-shrink:0"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            }
        </div>
    }
    } @* end @if currentCycle *@
}

@if (analytics is not null)
{
    <div class="dashboard-analytics-grid">
        <div class="card analytics-card">
            <div class="card-header">Today's Activity</div>
            <div class="analytics-stat-grid"><div><strong>@analytics.Steps.Today.ToString("N0")</strong><span>steps today</span></div><div><strong>@analytics.Steps.ThisWeekAverage.ToString("N0")</strong><span>daily avg this week</span></div></div>
            <div class="analytics-muted">Cardio · @analytics.Steps.Today.ToString("N0") Steps · Google Health</div>
        </div>
        <div class="card analytics-card">
            <div class="card-header">This Week</div>
            <div class="analytics-stat-grid">
                <div><strong>@(analytics.ThisWeek.ProgrammedWorkouts + analytics.ThisWeek.PplSessions)</strong><span>workouts</span></div>
                <div><strong>@analytics.ThisWeek.CardioSessions</strong><span>cardio</span></div>
                <div><strong>@analytics.ThisWeek.StrengthVolume.ToString("N0")</strong><span>lb volume</span></div>
            </div>

    @if (analytics.Steps.ThisWeekDaysWithData > 0)
    {
        <div class="card analytics-card">
            <div class="card-header">Steps This Week</div>
            <div class="analytics-muted">Average @analytics.Steps.ThisWeekAverage.ToString("N0")/day · @analytics.Steps.ThisWeekDaysWithData days with data</div>
            <div class="analytics-muted">Highest @analytics.Steps.ThisWeekHighest.ToString("N0") · Lowest @analytics.Steps.ThisWeekLowest.ToString("N0")</div>
            <div class="monthly-chart" aria-label="Weekly steps chart">
                @foreach (var point in analytics.Steps.ThisWeek)
                {
                    <div class="month-column" title="@point.Date.ToString("ddd"): @point.Steps.ToString("N0") steps"><div class="month-bar" style="height:@(point.Steps * 100 / Math.Max(1, analytics.Steps.ThisWeekHighest))%"></div><span>@point.Date.ToString("ddd")</span></div>
                }
            </div>
        </div>
    }
        </div>
        <div class="card analytics-card">
            <div class="card-header">Year to Date</div>
            <div class="analytics-stat-grid">
                <div><strong>@analytics.YearToDate.TotalSessions</strong><span>sessions</span></div>
                <div><strong>@analytics.YearToDate.CompletedSets</strong><span>sets</span></div>
                <div><strong>@analytics.YearToDate.CardioMinutes.ToString("N0")</strong><span>cardio min</span></div>
            </div>
            <div class="analytics-muted">@analytics.YearToDate.ProgrammedWorkouts programmed · @analytics.YearToDate.AdditionalStrengthSessions additional strength</div>
        </div>
    </div>

    @if (analytics.Steps.IsConnected)
    {
        <div class="card analytics-card analytics-chart-card">
            <div class="card-header">Steps — Last 30 Days</div>
            <div class="analytics-muted">Daily steps from Google Health</div>
            <div class="steps-30-day-chart" aria-label="Google Health steps for the last 30 days">
                @foreach (var point in analytics.Steps.Last30Days)
                {
                    <div class="steps-30-day-column" title="@point.Date.ToString("d"): @point.Steps.ToString("N0") steps">
                        <div class="steps-30-day-bar" style="height:@(point.Steps * 100 / Math.Max(1, analytics.Steps.Last30Days.Max(x => x.Steps)))%"></div>
                        <span>@point.Date.ToString("M/d")</span>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card analytics-card analytics-chart-card">
        <div class="card-header">Training Activity</div>
        <p class="analytics-description">Completed sessions and actual lifting volume by month. Planned sets are not included in volume.</p>
        <div class="monthly-chart" aria-label="Monthly training activity chart">
            @foreach (var month in analytics.MonthlyTraining)
            {
                var maxSessions = Math.Max(1, analytics.MonthlyTraining.Max(x => x.Sessions));
                <div class="month-column" title="@month.Label: @month.Sessions sessions, @month.StrengthVolume.ToString("N0") lb volume">
                    <div class="month-bar" style="height:@(month.Sessions * 100 / maxSessions)%"></div>
                    <span>@month.Label</span>
                </div>
            }
        </div>
        <p class="analytics-summary">@GetActivitySummary()</p>
    </div>

    @if (analytics.StrengthProgress.Count > 0)
    {
        <div class="card analytics-card">
            <div class="card-header">Estimated 1RM by Lift</div>
            <p class="analytics-description">Estimated 1RM uses the existing rounded Epley formula and actual completed sets.</p>
            <div class="estimated-1rm-table-wrapper">
                <table class="estimated-1rm-table">
                    <thead>
                        <tr>
                            <th scope="col">Lift</th>
                            <th scope="col">Current</th>
                            <th scope="col">3 months</th>
                            <th scope="col">6 months</th>
                            <th scope="col">1 year</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in analytics.StrengthProgress)
                        {
                            <tr>
                                <th scope="row">@item.ExerciseName</th>
                                <td>@FormatWeight(item.Current)</td>
                                <td>@FormatWeight(item.ThreeMonthsAgo)</td>
                                <td>@FormatWeight(item.SixMonthsAgo)</td>
                                <td>@FormatWeight(item.OneYearAgo)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card analytics-card empty-analytics"><div class="card-header">Strength Progress</div><p>Complete a few workouts to start seeing strength trends here.</p></div>
    }

    @if (analytics.PersonalRecords.Count > 0)
    {
        <div class="card analytics-card">
            <div class="card-header">Personal Records</div>
            <div class="performance-records">
                @foreach (var record in analytics.PersonalRecords.Take(12))
                {
                    <a class="performance-record performance-record-link"
                       href="@($"/exercises/{ExerciseHistoryService.BuildKey(record.ExerciseName)}")">
                        <div>
                            <strong>@record.ExerciseName</strong>
                            <div class="analytics-muted">@record.RecordType · @record.Date.ToLocalTime().ToString("MMM d, yyyy")</div>
                        </div>
                        <span class="badge badge-success">@FormatPersonalRecord(record)</span>
                    </a>
                }
            </div>
        </div>
    }

    @if (analytics.YearToDate.CardioSessions > 0)
    {
        <div class="card analytics-card">
            <div class="card-header">Cardio This Year</div>
            <div class="analytics-stat-grid"><div><strong>@analytics.YearToDate.CardioSessions</strong><span>sessions</span></div><div><strong>@analytics.YearToDate.CardioMinutes.ToString("N0")</strong><span>minutes</span></div><div><strong>@analytics.YearToDate.CardioDistance.ToString("N0")</strong><span>@(analytics.YearToDate.CardioDistanceUnit?.ToString().ToLowerInvariant() ?? "distance units")</span></div></div>
        </div>
    }
}

@code {
    private Cycle? currentCycle;
    private List<Lift> lifts = [];
    private List<Workout> upcomingWorkouts = [];
    private PplProgram? activePplProgram;
    private PplWeekPlan? pplWeekPlan;
    private bool pplStarting;
    private string? pplError;
    private bool loading = true;
    private DashboardAnalytics? analytics;
    private SiteContent? recentReview;
    private SiteContent? recentBlogPost;
    private static string RatingStars(int rating) => new string('★', rating) + new string('☆', 5 - rating);
    private bool showSetup;
    private bool enableBbb;
    private bool enableWarmup;
    private bool enableFivesPro;
    private bool enableFsl;
    private BbbMode selectedBbbMode = BbbMode.OppositeDay;
    private double selectedBbbPct = 50;

    private int totalWorkouts;
    private int completedWorkouts;
    private int progressPercent;
    private string currentWeekDisplay = "-";

    protected override async Task OnInitializedAsync()
    {
        // Load once the circuit is interactive; prerender shows the loading state instead of querying twice.
        if (!RendererInfo.IsInteractive) return;

        var userId = await UserContext.GetUserIdOrNullAsync();
        if (userId is not null)
            await UserInitService.EnsureUserInitializedAsync(userId);
        await LoadData();
        loading = false;
    }

    private async Task LoadData()
    {
        recentReview = await Db.SiteContents.AsNoTracking()
            .Where(post => post.Type == SiteContentType.ProductReview && post.Status == SiteContentStatus.Published)
            .OrderByDescending(post => post.PublishedAtUtc)
            .ThenByDescending(post => post.Id)
            .FirstOrDefaultAsync();
        recentBlogPost = await Db.SiteContents.AsNoTracking()
            .Where(post => post.Type == SiteContentType.BlogPost && post.Status == SiteContentStatus.Published)
            .OrderByDescending(post => post.PublishedAtUtc)
            .ThenByDescending(post => post.Id)
            .FirstOrDefaultAsync();
        analytics = await DashboardAnalyticsService.GetDashboardAsync();
        currentCycle = await CycleService.GetCurrentCycleAsync();
        if (analytics.Program.ProgramType == "5/3/1")
        {
            totalWorkouts = analytics.Program.PlannedSessions;
            completedWorkouts = analytics.Program.CompletedSessions;
            progressPercent = analytics.Program.CompletionPercent;
        }
        lifts = await LiftService.GetAllLiftsAsync();
        activePplProgram = await PplProgramService.GetActiveProgramAsync();
        if (activePplProgram is not null)
        {
            try { pplWeekPlan = await PplProgramService.GetWeekPlanAsync(activePplProgram.Id); }
            catch (InvalidOperationException) { pplWeekPlan = null; }
        }

        if (currentCycle is not null)
        {
            var allWorkouts = currentCycle.Weeks.SelectMany(w => w.Workouts).ToList();

            var activeWeek = currentCycle.Weeks
                .OrderBy(w => w.WeekNumber)
                .FirstOrDefault(w => w.Workouts.Any(wo => wo.Status != WorkoutStatus.Completed));
            currentWeekDisplay = activeWeek is not null
                ? $"Week {(int)activeWeek.WeekNumber}"
                : "Done";

            upcomingWorkouts = allWorkouts
                .Where(w => w.Status != WorkoutStatus.Completed)
                .OrderBy(w => w.Week.WeekNumber).ThenBy(w => w.MainLiftType)
                .Take(6)
                .ToList();
        }
    }

    private static string FormatWeight(double? value) => value is null ? "No data" : $"{value:N0} lb";
    private string GetActivitySummary() => analytics is null ? "" : $"{analytics.YearToDate.TotalSessions} sessions logged this year.";
    private static string FormatPersonalRecord(PersonalRecord record) => record.RecordType switch
    {
        "Rep PR" => $"{record.Value:N0} reps",
        _ => $"{record.Value:N0} lb"
    };

    private async Task CreateFirstCycle()
    {
        loading = true;
        var mode = enableBbb ? selectedBbbMode : BbbMode.None;
        await CycleService.CreateCycleAsync(mode, selectedBbbPct, enableWarmup, enableFivesPro, enableFsl);
        showSetup = false;
        await LoadData();
        loading = false;
    }

    private async Task StartNextPplSession()
    {
        if (activePplProgram is null) return;
        var target = pplWeekPlan?.OpenDay ?? pplWeekPlan?.Suggested;
        if (target is not null)
        {
            await OpenPplDay(target);
            return;
        }
        await RunPplStart(() => PplProgramService.GetOrCreateNextSessionAsync(activePplProgram.Id));
    }

    private async Task OpenPplDay(PplWeekDay day)
    {
        if (activePplProgram is null) return;
        if (day.SessionId is int sessionId && day.State != PplDayState.Available)
        {
            Nav.NavigateTo($"/ppl/session/{sessionId}");
            return;
        }
        await RunPplStart(() => PplProgramService.StartSessionAsync(activePplProgram.Id, day.DayTemplateId));
    }

    private async Task RunPplStart(Func<Task<PplSession>> start)
    {
        pplStarting = true;
        pplError = null;
        try
        {
            var session = await start();
            Nav.NavigateTo($"/ppl/session/{session.Id}");
        }
        catch (InvalidOperationException ex)
        {
            pplError = ex.Message;
        }
        finally
        {
            pplStarting = false;
        }
    }

    private static string GetPplDayStateLabel(PplWeekDay day, bool isSuggested) => day.State switch
    {
        PplDayState.Completed => "Done",
        PplDayState.Open => day.HasLoggedSets ? "In progress" : "Ready",
        _ => isSuggested ? "Up next" : "Start"
    };

    private void GoToWorkout(int id) => Nav.NavigateTo("/workout/" + id);

    private void GoToCycle()
    {
        if (currentCycle is not null)
            Nav.NavigateTo("/cycles/" + currentCycle.Id);
    }

    private static string GetLiftDisplayName(LiftType lt) => lt switch
    {
        LiftType.Squat       => "Squat",
        LiftType.BenchPress  => "Bench Press",
        LiftType.Deadlift    => "Deadlift",
        LiftType.OverheadPress => "Overhead Press",
        _                    => lt.ToString()
    };

    private static string GetWeekLabel(WeekNumber wn) => wn switch
    {
        WeekNumber.Week1 => "5s",
        WeekNumber.Week2 => "3s",
        WeekNumber.Week3 => "5/3/1",
        WeekNumber.Week4 => "Deload",
        _                => ""
    };

    private static string GetStatusClass(WorkoutStatus s) => s switch
    {
        WorkoutStatus.Completed  => "status-completed",
        WorkoutStatus.InProgress => "status-in-progress",
        _                        => "status-not-started",
    };

    private static string GetDayTypeBadge(PplDayType t) => t switch
    {
        PplDayType.Push => "badge-push",
        PplDayType.Pull => "badge-pull",
        PplDayType.Legs => "badge-legs",
        _ => "badge-muted"
    };
}
