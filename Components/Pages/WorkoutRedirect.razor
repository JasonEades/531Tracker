@page "/workout"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICycleService CycleService
@inject NavigationManager Nav

@* Redirect page: navigates to the current cycle, or cycles list if none exists. *@

@code {
    protected override async Task OnInitializedAsync()
    {
        var currentCycle = await CycleService.GetCurrentCycleAsync();
        if (currentCycle is not null)
            Nav.NavigateTo($"/cycles/{currentCycle.Id}", replace: true);
        else
            Nav.NavigateTo("/cycles", replace: true);
    }
}
