@page "/workout"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICycleService CycleService
@inject NavigationManager Nav

@* Resume an active workout when present; otherwise open the current cycle. *@

@code {
    protected override async Task OnInitializedAsync()
    {
        var currentCycle = await CycleService.GetCurrentCycleAsync();
        if (currentCycle is not null)
        {
            var inProgressWorkout = currentCycle.Weeks
                .SelectMany(week => week.Workouts)
                .FirstOrDefault(workout => workout.Status == WorkoutStatus.InProgress);

            Nav.NavigateTo(
                inProgressWorkout is null
                    ? $"/cycles/{currentCycle.Id}"
                    : $"/workout/{inProgressWorkout.Id}",
                replace: true);
        }
        else
            Nav.NavigateTo("/cycles", replace: true);
    }
}
