@page "/workout"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICycleService CycleService
@inject IPplProgramService PplProgramService
@inject NavigationManager Nav

@* Open the workout to train next (5/3/1 or PPL); never the History pages. *@

@code {
    protected override async Task OnInitializedAsync()
    {
        var currentCycle = await CycleService.GetCurrentCycleAsync();
        var activePplProgram = await PplProgramService.GetActiveProgramAsync();
        PplWeekPlan? pplWeekPlan = null;
        if (activePplProgram is not null)
        {
            try { pplWeekPlan = await PplProgramService.GetWeekPlanAsync(activePplProgram.Id); }
            catch (InvalidOperationException) { }
        }

        Nav.NavigateTo(WorkoutDestination.Resolve(currentCycle, activePplProgram, pplWeekPlan), replace: true);
    }
}
