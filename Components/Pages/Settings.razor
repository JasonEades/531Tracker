@page "/settings"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using FiveThreeOneTracker.Data
@using FiveThreeOneTracker.Models
@inject AppDbContext Db
@inject ICurrentUserService UserContext
@inject IGoogleHealthAuthorizationService HealthAuthorization
@inject IGoogleHealthSyncService HealthSync
@inject IPlateCalculatorService PlateCalc
@inject NavigationManager Nav

<PageTitle>Settings — The Lifting Lab</PageTitle>

<div class="page-header">
    <div>
        <div class="eyebrow">ACCOUNT</div>
        <h1>Settings</h1>
    </div>
</div>

<section class="card mb-4">
    <div class="card-header">
        <div>
            <div class="eyebrow">HEALTH INTEGRATIONS</div>
            <h2>Google Health</h2>
        </div>
        <span class="badge @(connection?.Status == HealthConnectionStatus.Connected ? "badge-success" : "badge-muted")">
            @(connection?.Status == HealthConnectionStatus.Connected ? "Connected" : "Not connected")
        </span>
    </div>
    <p class="text-muted">Daily Google Health step totals are automatically added to your training weeks as Cardio → Steps.</p>

    @if (connection?.Status == HealthConnectionStatus.Connected)
    {
        <div class="settings-grid mt-3">
            <div><strong>Daily Steps</strong><br /><span class="text-muted">Read access granted</span></div>
            <div><strong>Last synced</strong><br /><span class="text-muted">@(connection.LastSyncedAtUtc?.ToLocalTime().ToString("g") ?? "Not yet synced")</span></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(syncMessage))
        {
            <p class="text-muted mt-3">@syncMessage</p>
        }
        <div class="flex gap-1 mt-3">
            <button class="btn btn-primary" @onclick="SyncNow" disabled="@busy">@(busy ? "Syncing…" : "Sync Now")</button>
            <button class="btn btn-outline" @onclick="Connect">Reconnect</button>
            <button class="btn btn-outline" @onclick="Disconnect" disabled="@busy">Disconnect</button>
        </div>
    }
    else
    {
        <p class="text-muted">Connect Google Health to import your daily step count and add it to your training week.</p>
        <button class="btn btn-primary mt-2" @onclick="Connect">Connect Google Health</button>
    }
</section>

@if (loading)
{
    <div class="loading"><div class="spinner"></div></div>
}
else if (equipment is not null)
{
    <div class="settings-section animate-fade-in">
        <div class="settings-section-label">Account</div>
        <div class="card">
            <div class="card-body">
                <a class="btn btn-danger btn-full" href="/logout">Sign out</a>
            </div>
        </div>
    </div>

    <div class="settings-section animate-fade-in">
        <div class="settings-section-label">Your Bars</div>
        <p class="text-muted mb-3" style="font-size:var(--text-sm)">Add every bar you train with. The <strong style="color:var(--color-text-2)">default</strong> bar is used unless a workout overrides it.</p>
        <div class="card">
            <div class="card-body" style="padding:0">
                @foreach (var bar in bars)
                {
                    <div class="plate-row">
                        <div class="plate-visual-wrap">
                            <span class="plate-visual-badge" style="background:rgba(94,124,255,0.15);color:#5E7CFF;border-color:#5E7CFF;">@FormatPlateWeight(bar.Weight)</span>
                            @if (editingBarId == bar.Id)
                            {
                                <div style="display:flex;gap:var(--space-2);flex:1">
                                    <input class="form-control" style="flex:1" @bind="editBarName" placeholder="Bar name" />
                                    <input class="form-control" type="number" style="width:90px" @bind="editBarWeight" step="0.5" />
                                </div>
                            }
                            else
                            {
                                <div>
                                    <div class="plate-weight-label">@bar.Name</div>
                                    <div class="text-muted" style="font-size:var(--text-xs)">@FormatPlateWeight(bar.Weight) lbs @(bar.IsDefault ? "· Default" : "")</div>
                                </div>
                            }
                        </div>
                        <div style="display:flex;gap:var(--space-2);align-items:center">
                            @if (editingBarId == bar.Id)
                            {
                                <button class="btn btn-sm btn-primary" @onclick="SaveBarEdit">Save</button>
                                <button class="btn btn-sm btn-outline" @onclick="CancelBarEdit">Cancel</button>
                            }
                            else
                            {
                                @if (!bar.IsDefault)
                                {
                                    <button class="btn btn-sm btn-outline" @onclick="() => SetDefaultBar(bar.Id)">Set Default</button>
                                }
                                <button class="btn btn-sm btn-outline" @onclick="() => StartBarEdit(bar)">Edit</button>
                                @if (bars.Count > 1)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteBar(bar.Id)">✕</button>
                                }
                            }
                        </div>
                    </div>
                }
                <div class="plate-row">
                    <div class="plate-visual-wrap" style="flex:1">
                        <input class="form-control" style="flex:1" @bind="newBarName" placeholder="New bar name (e.g. Trap Bar)" />
                        <input class="form-control" type="number" style="width:100px" @bind="newBarWeight" step="0.5" placeholder="Weight" />
                    </div>
                    <button class="btn btn-sm btn-primary" @onclick="AddBar" disabled="@(string.IsNullOrWhiteSpace(newBarName))">+ Add Bar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="settings-section animate-fade-in">
        <div class="settings-section-label">Plate Inventory</div>
        <p class="text-muted mb-3" style="font-size:var(--text-sm)">Number of <strong style="color:var(--color-text-2)">pairs</strong> of each plate you own.</p>
        <div class="card">
            <div class="card-body" style="padding:0">
                @foreach (var plate in equipment.Plates.OrderByDescending(p => p.Weight))
                {
                    <div class="plate-row">
                        <div class="plate-visual-wrap">
                            <span class="plate-visual-badge" style="@GetPlateAccentStyle(plate.Weight)">@FormatPlateWeight(plate.Weight)</span>
                            <span class="plate-weight-label">@FormatPlateWeight(plate.Weight) lb</span>
                        </div>
                        <div class="plate-stepper">
                            <button class="plate-step-btn" @onclick="() => AdjustPlate(plate.Id, plate.PairsAvailable - 1)" disabled="@(plate.PairsAvailable <= 0)">−</button>
                            <span class="plate-step-value">@plate.PairsAvailable</span>
                            <button class="plate-step-btn" @onclick="() => AdjustPlate(plate.Id, plate.PairsAvailable + 1)">+</button>
                        </div>
                        <span class="text-muted" style="font-size:var(--text-xs);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;width:36px;text-align:right">pairs</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="settings-section animate-fade-in">
        <div class="settings-section-label">Plate Calculator</div>
        <div class="card">
            <div class="card-body">
                <div class="calc-input-row">
                    <div class="form-group mb-0" style="flex:1">
                        <label class="form-label">Bar</label>
                        <select class="form-control" @bind="testBarId">
                            @foreach (var bar in bars)
                            {
                                <option value="@bar.Id">@bar.Name (@FormatPlateWeight(bar.Weight) lbs)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0" style="flex:1">
                        <label class="form-label">Target Weight (lbs)</label>
                        <input type="number" class="form-control" inputmode="numeric" @bind="testWeight" step="5" />
                    </div>
                    <button class="btn btn-primary calc-btn" @onclick="TestCalculate">Calculate</button>
                </div>
                @if (testResults is not null)
                {
                    @if (testWeight <= TestBarWeight)
                    {
                        <div class="calc-result mt-3"><span class="calc-result-label">Just the bar</span><span class="text-muted" style="font-size:var(--text-sm)">@TestBarWeight lbs — no plates needed</span></div>
                    }
                    else if (testResults.Count == 0)
                    {
                        <div class="calc-result mt-3"><span class="text-danger">Cannot make @testWeight lbs with your current plates.</span></div>
                    }
                    else
                    {
                        <div class="calc-result mt-3">
                            <div class="calc-barbell">
                                <div class="calc-plates-left">
                                    @foreach (var result in testResults)
                                    {
                                        @for (int i = 0; i < result.CountPerSide; i++)
                                        {
                                            <span class="calc-plate" style="@GetPlateAccentStyle(result.PlateWeight)">@FormatPlateWeight(result.PlateWeight)</span>
                                        }
                                    }
                                </div>
                                <div class="calc-bar-center">│ @TestBarWeight lb bar │</div>
                                <div class="calc-plates-right">
                                    @foreach (var result in testResults)
                                    {
                                        @for (int i = 0; i < result.CountPerSide; i++)
                                        {
                                            <span class="calc-plate" style="@GetPlateAccentStyle(result.PlateWeight)">@FormatPlateWeight(result.PlateWeight)</span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="calc-each-side">
                                Each side:
                                @foreach (var result in testResults)
                                {
                                    <span class="calc-plate-chip" style="@GetPlateAccentStyle(result.PlateWeight)">@result.CountPerSide × @FormatPlateWeight(result.PlateWeight)</span>
                                }
                            </div>
                            @if (Math.Abs(ActualTotal - testWeight) > 0.01)
                            {
                                <p class="text-warning mt-1" style="font-size:var(--text-sm)">⚠️ Closest loadable: @ActualTotal lbs (off by @(Math.Abs(testWeight - ActualTotal)) lbs)</p>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (!string.IsNullOrWhiteSpace(authorizationError))
{
    <div class="alert alert-danger">@authorizationError</div>
}

@code {
    private GoogleHealthConnection? connection;
    private bool busy;
    private string? error;
    private string? authorizationError;
    private string? syncMessage;
    private UserEquipment? equipment;
    private List<Bar> bars = [];
    private bool loading = true;
    private double testWeight = 135;
    private int testBarId;
    private List<PlateLoadingResult>? testResults;
    private int? editingBarId;
    private string editBarName = "";
    private double editBarWeight;
    private string newBarName = "";
    private double newBarWeight = 45;

    private double TestBarWeight => bars.FirstOrDefault(b => b.Id == testBarId)?.Weight ?? 45;
    private double ActualTotal => testResults is null ? 0 : TestBarWeight + testResults.Sum(r => r.PlateWeight * r.CountPerSide * 2);

    protected override async Task OnInitializedAsync()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.ContainsKey("healthError"))
        {
            var reference = query.TryGetValue("healthErrorRef", out var value) ? value.ToString() : null;
            authorizationError = string.IsNullOrWhiteSpace(reference)
                ? "Google Health authorization failed. Check the application logs for the provider error."
                : $"Google Health authorization failed. Check the application logs using failure reference {reference}.";
        }

        await LoadAsync();
        equipment = await PlateCalc.GetEquipmentAsync();
        bars = await PlateCalc.GetBarsAsync();
        testBarId = bars.FirstOrDefault(b => b.IsDefault)?.Id ?? bars.FirstOrDefault()?.Id ?? 0;
        loading = false;
    }

    private async Task LoadAsync()
    {
        var userId = await UserContext.GetUserIdAsync();
        connection = await Db.GoogleHealthConnections.AsNoTracking().SingleOrDefaultAsync(x => x.UserId == userId);
    }

    private void Connect()
    {
        Nav.NavigateTo("/health/google/connect?returnUrl=/settings", forceLoad: true);
    }

    private async Task SyncNow()
    {
        busy = true;
        error = null;
        syncMessage = null;
        try
        {
            var result = await HealthSync.SyncAsync(DateTime.UtcNow.Date.AddDays(-90), DateTime.UtcNow.Date);
            syncMessage = $"Imported {result.ImportedRecords} records; updated {result.UpdatedRecords}; created {result.CardioAdditions} cardio additions; {result.UnassignedRecords} remain outside a training cycle.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Disconnect()
    {
        busy = true;
        error = null;
        try
        {
            await HealthAuthorization.DisconnectAsync(await UserContext.GetUserIdAsync());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AdjustPlate(int plateId, int newPairs)
    {
        await PlateCalc.UpdatePlateAsync(plateId, newPairs);
        equipment = await PlateCalc.GetEquipmentAsync();
        testResults = null;
    }

    private async Task AddBar()
    {
        if (string.IsNullOrWhiteSpace(newBarName)) return;
        await PlateCalc.AddBarAsync(newBarName.Trim(), newBarWeight);
        bars = await PlateCalc.GetBarsAsync();
        newBarName = "";
        newBarWeight = 45;
    }

    private void StartBarEdit(Bar bar)
    {
        editingBarId = bar.Id;
        editBarName = bar.Name;
        editBarWeight = bar.Weight;
    }

    private void CancelBarEdit() => editingBarId = null;

    private async Task SaveBarEdit()
    {
        if (editingBarId is int id && !string.IsNullOrWhiteSpace(editBarName))
        {
            await PlateCalc.UpdateBarAsync(id, editBarName.Trim(), editBarWeight);
            bars = await PlateCalc.GetBarsAsync();
        }
        editingBarId = null;
    }

    private async Task DeleteBar(int barId)
    {
        await PlateCalc.DeleteBarAsync(barId);
        bars = await PlateCalc.GetBarsAsync();
        if (testBarId == barId)
            testBarId = bars.FirstOrDefault(b => b.IsDefault)?.Id ?? bars.FirstOrDefault()?.Id ?? 0;
    }

    private async Task SetDefaultBar(int barId)
    {
        await PlateCalc.SetDefaultBarAsync(barId);
        bars = await PlateCalc.GetBarsAsync();
    }

    private async Task TestCalculate() => testResults = await PlateCalc.CalculatePlates(testWeight, TestBarWeight);

    private static string FormatPlateWeight(double w) => w == (int)w ? ((int)w).ToString() : w.ToString("0.#");

    private static string GetPlateAccentStyle(double weight) => weight switch
    {
        >= 45 => "background:rgba(37,99,235,0.25);color:#60a5fa;border-color:#2563eb;",
        >= 35 => "background:rgba(202,138,4,0.2);color:#fbbf24;border-color:#ca8a04;",
        >= 25 => "background:rgba(22,163,74,0.2);color:#4ade80;border-color:#16a34a;",
        >= 15 => "background:rgba(139,92,246,0.2);color:#a78bfa;border-color:#8b5cf6;",
        >= 10 => "background:rgba(148,163,184,0.15);color:#94a3b8;border-color:#475569;",
        >= 5 => "background:rgba(239,68,68,0.2);color:#f87171;border-color:#ef4444;",
        _ => "background:rgba(107,114,128,0.2);color:#9ca3af;border-color:#6b7280;"
    };
}
