@page "/ppl/history"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IPplProgramService PplService
@inject NavigationManager Nav

@* Legacy route: PPL sessions now live on the program landing page. *@
<div class="loading"><div class="spinner"></div></div>

@code {
    [SupplyParameterFromQuery] public int? ProgramId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        var id = ProgramId ?? (await PplService.GetActiveProgramAsync())?.Id;
        Nav.NavigateTo(id is int programId ? $"/ppl/{programId}?view=past" : "/cycles", replace: true);
    }
}
