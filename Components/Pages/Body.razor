@page "/body"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IBodyMetricService BodyMetrics

<PageTitle>Body — Jason's Garage Lab</PageTitle>

<div class="animate-fade-in">
    <div class="page-header mb-4">
        <h1>Body</h1>
    </div>

    @if (loading)
    {
        <div class="loading"><div class="spinner"></div></div>
    }
    else
    {
        @if (trends.Count > 0)
        {
            <div class="body-trend-grid mb-4">
                @foreach (var trend in trends)
                {
                    <div class="body-trend-card">
                        <div class="body-trend-label">@trend.Label</div>
                        <div class="body-trend-value">@FormatValue(trend.Latest) <small>@trend.Unit</small></div>
                        <div class="body-trend-deltas">
                            <span>30d @FormatDelta(trend.ChangeOver30Days)</span>
                            <span>90d @FormatDelta(trend.ChangeOver90Days)</span>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="card mb-4">
            <div class="card-header">Log measurements</div>
            <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="body-metrics">
                <div class="body-form-grid">
                    <label>Date
                        <InputDate class="form-control" @bind-Value="form.RecordedOn" />
                    </label>
                    <label>Weight (lb)
                        <InputNumber class="form-control" @bind-Value="form.WeightLb" step="0.1" />
                    </label>
                    <label>Body fat (%)
                        <InputNumber class="form-control" @bind-Value="form.BodyFatPercent" step="0.1" />
                    </label>
                    <label>Neck (in)
                        <InputNumber class="form-control" @bind-Value="form.NeckInches" step="0.1" />
                    </label>
                    <label>Chest (in)
                        <InputNumber class="form-control" @bind-Value="form.ChestInches" step="0.1" />
                    </label>
                    <label>Waist (in)
                        <InputNumber class="form-control" @bind-Value="form.WaistInches" step="0.1" />
                    </label>
                    <label>Hips (in)
                        <InputNumber class="form-control" @bind-Value="form.HipsInches" step="0.1" />
                    </label>
                    <label>Thigh (in)
                        <InputNumber class="form-control" @bind-Value="form.ThighInches" step="0.1" />
                    </label>
                    <label>Arm (in)
                        <InputNumber class="form-control" @bind-Value="form.ArmInches" step="0.1" />
                    </label>
                </div>
                <label class="body-form-notes">Notes
                    <InputTextArea class="form-control" rows="2" @bind-Value="form.Notes" />
                </label>
                <div class="flex items-center gap-2 mt-3">
                    <button class="btn btn-primary" type="submit" disabled="@saving">Save entry</button>
                    @if (!string.IsNullOrEmpty(saveMessage))
                    {
                        <span class="analytics-muted">@saveMessage</span>
                    }
                </div>
            </EditForm>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                Progress photos
                @if (quota is not null)
                {
                    <span class="badge badge-muted">@quota.Used / @quota.Limit</span>
                }
            </div>

            <p class="analytics-muted">
                Photos are resized and compressed on upload to save space, and you can keep up to
                @quota?.Limit at a time. Delete an older photo to make room.
            </p>

            <div class="body-photo-upload">
                <label>Photo date
                    <input class="form-control" type="date" @bind="photoDate" />
                </label>
                <label>Caption
                    <input class="form-control" type="text" maxlength="200" @bind="photoCaption" placeholder="Optional" />
                </label>
            </div>

            <div class="photo-dropzone @(uploading ? "is-uploading" : "") @(quota?.IsFull == true ? "is-disabled" : "") @(selectedPhoto is not null ? "has-file" : "")">
                <InputFile @key="uploaderKey" OnChange="SelectPhoto" accept="image/*" class="photo-dropzone-input"
                           disabled="@(uploading || quota?.IsFull == true)" />
                <div class="photo-dropzone-content">
                    @if (uploading)
                    {
                        <div class="spinner photo-dropzone-spinner"></div>
                        <strong>Uploading and optimizing…</strong>
                    }
                    else if (quota?.IsFull == true)
                    {
                        <strong>Photo limit reached</strong>
                        <span>Delete an older photo to add a new one.</span>
                    }
                    else if (selectedPhoto is not null)
                    {
                        <svg class="photo-dropzone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                        <strong class="photo-dropzone-filename">@selectedPhoto.Name</strong>
                        <span>@FormatFileSize(selectedPhoto.Size) · tap to choose a different photo</span>
                    }
                    else
                    {
                        <svg class="photo-dropzone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        <strong><span class="photo-dropzone-desktop">Drag &amp; drop a photo, or </span><span class="photo-dropzone-link">browse</span></strong>
                        <span>JPG, PNG, HEIC or WebP · resized automatically</span>
                    }
                </div>
            </div>

            <div class="photo-upload-actions">
                <button class="btn btn-primary" @onclick="UploadPhotoAsync"
                        disabled="@(selectedPhoto is null || uploading || quota?.IsFull == true)">
                    @(uploading ? "Saving…" : "Save Photo")
                </button>
                @if (selectedPhoto is not null && !uploading)
                {
                    <button class="btn btn-outline" @onclick="ClearSelectedPhoto">Clear</button>
                }
            </div>

            @if (!string.IsNullOrEmpty(photoMessage))
            {
                <div class="analytics-muted mt-2">@photoMessage</div>
            }

            @if (photos.Count > 0)
            {
                <div class="photo-timeline mt-4">
                    @foreach (var year in photos.GroupBy(x => x.TakenOn.Year).OrderByDescending(x => x.Key))
                    {
                        <div class="photo-timeline-year">@year.Key</div>

                        @foreach (var month in year.GroupBy(x => x.TakenOn.Month).OrderByDescending(x => x.Key))
                        {
                            <div class="photo-timeline-month">
                                <span>@MonthName(month.Key)</span>
                                <small>@month.Count() photo@(month.Count() == 1 ? "" : "s")</small>
                            </div>

                            @foreach (var photo in month.OrderByDescending(x => x.TakenOn).ThenByDescending(x => x.Id))
                            {
                                <div class="photo-timeline-item">
                                    <div class="photo-timeline-marker"></div>
                                    <div class="photo-timeline-body">
                                        <div class="photo-timeline-date">
                                            @photo.TakenOn.ToString("dddd, MMM d")
                                            <small>@DescribeAge(photo.TakenOn)</small>
                                        </div>
                                        <a href="@PhotoUrl(photo, thumb: false)" target="_blank" rel="noopener">
                                            <img class="photo-timeline-image" src="@PhotoUrl(photo, thumb: true)"
                                                 alt="@(photo.Caption ?? "Progress photo")" loading="lazy" />
                                        </a>
                                        @if (editingCaptionId == photo.Id)
                                        {
                                            <div class="photo-timeline-caption-edit">
                                                <input class="form-control" type="text" maxlength="200"
                                                       placeholder="Add a caption"
                                                       @bind="captionDraft" @bind:event="oninput"
                                                       @onkeydown="e => CaptionKeyDown(e, photo.Id)" />
                                                <div class="photo-timeline-actions">
                                                    <button class="btn btn-sm btn-primary"
                                                            @onclick="() => SaveCaptionAsync(photo.Id)">Save</button>
                                                    <button class="btn btn-sm" @onclick="CancelCaptionEdit">Cancel</button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrWhiteSpace(photo.Caption))
                                            {
                                                <div class="photo-timeline-caption">@photo.Caption</div>
                                            }
                                            <div class="photo-timeline-actions">
                                                <button class="btn btn-sm" @onclick="() => BeginCaptionEdit(photo)">
                                                    @(string.IsNullOrWhiteSpace(photo.Caption) ? "Add caption" : "Edit caption")
                                                </button>
                                                <button class="btn btn-sm" title="Rotate left"
                                                        disabled="@(busyPhotoId == photo.Id)"
                                                        @onclick="() => RotateAsync(photo.Id, clockwise: false)">⟲ Left</button>
                                                <button class="btn btn-sm" title="Rotate right"
                                                        disabled="@(busyPhotoId == photo.Id)"
                                                        @onclick="() => RotateAsync(photo.Id, clockwise: true)">⟳ Right</button>
                                                <button class="btn btn-sm" style="color:var(--color-danger)"
                                                        disabled="@(busyPhotoId == photo.Id)"
                                                        @onclick="() => DeletePhotoAsync(photo.Id)">Delete</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">History</div>
            @if (entries.Count == 0)
            {
                <p class="analytics-muted">No entries yet. Log your first measurement above.</p>
            }
            else
            {
                <div class="estimated-1rm-table-wrapper">
                    <table class="estimated-1rm-table">
                        <thead>
                            <tr>
                                <th>Date</th><th>Weight</th><th>BF%</th><th>Chest</th>
                                <th>Waist</th><th>Hips</th><th>Thigh</th><th>Arm</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in entries)
                            {
                                <tr>
                                    <th>@entry.RecordedOn.ToString("MMM d, yyyy")</th>
                                    <td>@FormatValue(entry.WeightLb)</td>
                                    <td>@FormatValue(entry.BodyFatPercent)</td>
                                    <td>@FormatValue(entry.ChestInches)</td>
                                    <td>@FormatValue(entry.WaistInches)</td>
                                    <td>@FormatValue(entry.HipsInches)</td>
                                    <td>@FormatValue(entry.ThighInches)</td>
                                    <td>@FormatValue(entry.ArmInches)</td>
                                    <td>
                                        <button class="btn btn-sm" @onclick="() => EditEntry(entry)">Edit</button>
                                        <button class="btn btn-sm" style="color:var(--color-danger)"
                                                @onclick="() => DeleteEntryAsync(entry.Id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly BodyMetricEntry form = new() { RecordedOn = DateTime.Today };
    private List<BodyMetricEntry> entries = [];
    private List<BodyMetricTrend> trends = [];
    private List<ProgressPhotoInfo> photos = [];
    private PhotoQuota? quota;

    private DateTime photoDate = DateTime.Today;
    private string? photoCaption;
    private string? photoMessage;
    private string? saveMessage;
    private bool loading = true;
    private bool saving;
    private bool uploading;
    private IBrowserFile? selectedPhoto;
    private Guid uploaderKey = Guid.NewGuid();
    private int? busyPhotoId;
    private int? editingCaptionId;
    private string captionDraft = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        loading = false;
    }

    private async Task ReloadAsync()
    {
        entries = await BodyMetrics.GetEntriesAsync();
        trends = await BodyMetrics.GetTrendsAsync();
        photos = await BodyMetrics.GetPhotosAsync();
        quota = await BodyMetrics.GetPhotoQuotaAsync();
    }

    private async Task SaveAsync()
    {
        saving = true;
        saveMessage = null;
        try
        {
            if (!form.HasAnyValue)
            {
                saveMessage = "Enter at least one measurement.";
                return;
            }

            await BodyMetrics.UpsertAsync(form);
            await ReloadAsync();
            saveMessage = "Saved.";
        }
        finally
        {
            saving = false;
        }
    }

    private void EditEntry(BodyMetricEntry entry)
    {
        form.RecordedOn = entry.RecordedOn;
        form.WeightLb = entry.WeightLb;
        form.BodyFatPercent = entry.BodyFatPercent;
        form.NeckInches = entry.NeckInches;
        form.ChestInches = entry.ChestInches;
        form.WaistInches = entry.WaistInches;
        form.HipsInches = entry.HipsInches;
        form.ThighInches = entry.ThighInches;
        form.ArmInches = entry.ArmInches;
        form.Notes = entry.Notes;
        saveMessage = null;
    }

    private async Task DeleteEntryAsync(int id)
    {
        await BodyMetrics.DeleteEntryAsync(id);
        await ReloadAsync();
    }

    private async Task UploadPhotoAsync()
    {
        var file = selectedPhoto;
        if (file is null || uploading) return;

        uploading = true;
        photoMessage = null;
        try
        {
            var maxBytes = 25L * 1024 * 1024;
            await using var stream = file.OpenReadStream(maxBytes);
            var result = await BodyMetrics.AddPhotoAsync(stream, file.Size, photoDate, photoCaption);
            photoMessage = result.Success ? "Photo added." : result.Error;
            if (result.Success)
            {
                photoCaption = null;
                ClearSelectedPhoto();
                await ReloadAsync();
            }
        }
        catch (IOException)
        {
            photoMessage = "That photo is too large to upload.";
        }
        finally
        {
            uploading = false;
        }
    }

    private void SelectPhoto(InputFileChangeEventArgs e)
    {
        selectedPhoto = e.File;
        photoMessage = null;
    }

    // Changing the key recreates the InputFile so the browser's file selection is cleared too.
    private void ClearSelectedPhoto()
    {
        selectedPhoto = null;
        uploaderKey = Guid.NewGuid();
    }

    private static string FormatFileSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private async Task DeletePhotoAsync(int id)
    {
        busyPhotoId = id;
        try
        {
            await BodyMetrics.DeletePhotoAsync(id);
            photoMessage = null;
            await ReloadAsync();
        }
        finally
        {
            busyPhotoId = null;
        }
    }

    private async Task RotateAsync(int id, bool clockwise)
    {
        busyPhotoId = id;
        try
        {
            if (!await BodyMetrics.RotatePhotoAsync(id, clockwise))
            {
                photoMessage = "That photo couldn't be rotated.";
                return;
            }

            photoMessage = null;
            await ReloadAsync();
        }
        finally
        {
            busyPhotoId = null;
        }
    }

    private void BeginCaptionEdit(ProgressPhotoInfo photo)
    {
        editingCaptionId = photo.Id;
        captionDraft = photo.Caption ?? string.Empty;
        photoMessage = null;
    }

    private void CancelCaptionEdit()
    {
        editingCaptionId = null;
        captionDraft = string.Empty;
    }

    private async Task CaptionKeyDown(KeyboardEventArgs e, int id)
    {
        if (e.Key == "Enter") await SaveCaptionAsync(id);
        else if (e.Key == "Escape") CancelCaptionEdit();
    }

    private async Task SaveCaptionAsync(int id)
    {
        if (!await BodyMetrics.UpdatePhotoCaptionAsync(id, captionDraft))
        {
            photoMessage = "That caption couldn't be saved.";
            return;
        }

        CancelCaptionEdit();
        await ReloadAsync();
    }

    // The version token forces the browser to refetch after a rotation instead of reusing its cache.
    private static string PhotoUrl(ProgressPhotoInfo photo, bool thumb) =>
        $"/api/progress-photos/{photo.Id}?thumb={(thumb ? "true" : "false")}&v={photo.Version}";

    private static string MonthName(int month) =>
        System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month);

    private static string DescribeAge(DateTime takenOn)
    {
        var days = (int)(DateTime.Today - takenOn.Date).TotalDays;
        return days switch
        {
            <= 0 => "today",
            1 => "yesterday",
            < 30 => $"{days} days ago",
            < 365 => $"{days / 30} month{(days / 30 == 1 ? "" : "s")} ago",
            _ => $"{days / 365} year{(days / 365 == 1 ? "" : "s")} ago"
        };
    }

    private static string FormatValue(double? value) => value.HasValue ? value.Value.ToString("0.#") : "—";

    private static string FormatDelta(double? delta)
    {
        if (delta is null) return "—";
        if (Math.Abs(delta.Value) < 0.05) return "0";
        return (delta.Value > 0 ? "+" : "−") + Math.Abs(delta.Value).ToString("0.#");
    }
}
