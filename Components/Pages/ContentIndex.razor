@page "/blog"
@page "/reviews"
@using Microsoft.EntityFrameworkCore
@using FiveThreeOneTracker.Data
@using FiveThreeOneTracker.Models
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>@(IsReviews ? "Product Reviews" : "Training Blog") — Jason's Garage Lab</PageTitle>
<HeadContent>
    <meta name="description" content="@PageDescription" />
    <link rel="canonical" href="@CanonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jason's Garage Lab" />
    <meta property="og:title" content="@PageTitleText" />
    <meta property="og:description" content="@PageDescription" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@PageTitleText" />
    <meta name="twitter:description" content="@PageDescription" />
</HeadContent>

<div class="page-header">
    <div>
        <div class="eyebrow">JASON'S GARAGE LAB</div>
        <h1>@PageTitleText</h1>
        <p class="text-muted">@PageDescription</p>
    </div>
    <AuthorizeView Policy="@ContentEditorPolicy.Name">
        <Authorized>
            <a class="btn btn-primary content-new-post-button" href="/admin/content">New post</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (loading)
{
    <div class="loading"><div class="spinner"></div></div>
}
else if (entries.Count == 0)
{
    <section class="card"><div class="card-body text-muted">No @(IsReviews ? "reviews" : "posts") have been published yet.</div></section>
}
else
{
    <div class="public-content-list">
        @foreach (var entry in entries)
        {
            <article class="card public-content-card">
                <div class="card-body">
                    @if (entry.Type == SiteContentType.ProductReview)
                    {
                        <span class="content-type-tag product-review-tag">Product review</span>
                        <div class="eyebrow">@(entry.Brand is null ? entry.ProductName : $"{entry.Brand} · {entry.ProductName}")</div>
                        <div class="content-rating" aria-label="@($"{entry.Rating} out of 5 stars")">@RatingStars(entry.Rating ?? 0) <span>@entry.Rating/5</span></div>
                    }
                    else
                    {
                        <span class="content-type-tag blog-post-tag">Blog post</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.FeaturedImageUrl))
                    {
                        <a class="public-content-image-link" href="@DetailUrl(entry)" tabindex="-1" aria-hidden="true">
                            <img class="public-content-image" src="@entry.FeaturedImageUrl" alt="@entry.FeaturedImageCaption" />
                        </a>
                    }
                    <h2><a href="@DetailUrl(entry)">@entry.Title</a></h2>
                    <time datetime="@entry.PublishedAtUtc?.ToString("O")">@entry.PublishedAtUtc?.ToString("MMMM d, yyyy")</time>
                    @if (!string.IsNullOrWhiteSpace(entry.Summary))
                    {
                        <p class="public-content-summary">@entry.Summary</p>
                    }
                    <a class="content-read-link" href="@DetailUrl(entry)">Read more →</a>
                </div>
            </article>
        }
    </div>
}

@code {
    private List<SiteContent> entries = [];
    private bool loading = true;
    private SiteContentType? loadedContentType;
    private bool IsReviews => Nav.ToBaseRelativePath(Nav.Uri).Equals("reviews", StringComparison.OrdinalIgnoreCase);
    private string PageTitleText => IsReviews ? "Product Reviews" : "Training Blog";
    private string PageDescription => IsReviews
        ? "Independent product reviews from Jason's Garage Lab, with hands-on notes on strength training gear and equipment."
        : "Training articles, strength-program notes, and practical ideas from Jason's Garage Lab.";
    private string CanonicalUrl => $"{SiteContentSeo.ResolveBaseUrl(Configuration["Seo:BaseUrl"], Nav.BaseUri)}{(IsReviews ? "/reviews" : "/blog")}";

    protected override async Task OnParametersSetAsync()
    {
        var contentType = IsReviews ? SiteContentType.ProductReview : SiteContentType.BlogPost;
        if (loadedContentType == contentType) return;

        loading = true;
        entries = await Db.SiteContents.AsNoTracking()
            .Where(entry => entry.Status == SiteContentStatus.Published
                && entry.Type == contentType)
            .OrderByDescending(entry => entry.PublishedAtUtc)
            .ThenByDescending(entry => entry.Id)
            .ToListAsync();
        loadedContentType = contentType;
        loading = false;
    }

    private string DetailUrl(SiteContent entry) =>
        $"/{(entry.Type == SiteContentType.BlogPost ? "blog" : "reviews")}/{Uri.EscapeDataString(entry.Slug)}";

    private static string RatingStars(int rating) => new string('★', rating) + new string('☆', 5 - rating);
}
