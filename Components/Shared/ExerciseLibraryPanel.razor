@inject IExerciseLibraryService Library
@inject IAccessoryService AccessoryService
@inject NavigationManager Nav

@* Exercise catalog plus the user's custom exercises. Hosted on the Exercises hub. *@

<div>
    <p class="text-muted mb-3">Every exercise you can pick in 5/3/1 accessories and PPL. Add your own private exercise at the bottom.</p>

    <div class="setup-card mb-3">
        <div class="form-group">
            <label class="form-label" for="library-search">Search</label>
            <input id="library-search" class="form-control" type="search"
                   placeholder="Name, muscle, equipment…" @bind="search" @bind:after="LoadExercises" />
        </div>
        <div class="flex gap-1">
            <div class="form-group flex-1">
                <label class="form-label" for="muscle-filter">Primary muscle</label>
                <select id="muscle-filter" class="form-control" @bind="muscleFilter" @bind:after="LoadExercises">
                    <option value="">All muscle groups</option>
                    @foreach (var muscle in Enum.GetValues<MuscleGroup>())
                    {
                        <option value="@muscle">@muscle</option>
                    }
                </select>
            </div>
            <div class="form-group flex-1">
                <label class="form-label" for="equipment-filter">Equipment</label>
                <select id="equipment-filter" class="form-control" @bind="equipmentFilter" @bind:after="LoadExercises">
                    <option value="">All equipment</option>
                    @foreach (var equipment in equipmentOptions)
                    {
                        <option value="@equipment">@equipment</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="loading"><div class="spinner"></div></div>
    }
    else if (exercises.Count == 0)
    {
        <div class="empty-state"><h3>No matching exercises</h3><p>Try changing your search or filters.</p></div>
    }
    else
    {
        <div class="exercise-index">
            @foreach (var exercise in exercises)
            {
                <button class="exercise-index-row" @onclick="() => OpenExercise(exercise.Id)">
                    <div class="exercise-index-main">
                        <div class="exercise-index-name">@exercise.Name</div>
                        <div class="exercise-index-meta">
                            @exercise.PrimaryMuscle · @exercise.Equipment · @exercise.MovementType
                            @if (exercise.UserId is not null)
                            {
                                <span> · Custom</span>
                            }
                        </div>
                    </div>
                    <span aria-hidden="true">›</span>
                </button>
            }
        </div>
    }

    @if (FilteredLegacy.Any())
    {
        <div class="section-header mt-3">
            <h3>Your other exercises</h3>
        </div>
        <p class="text-muted mb-2" style="font-size:var(--text-sm)">
            Older accessories that aren't in the library yet. Link one to a library exercise to merge them; logged history is kept.
        </p>
        <div class="exercise-index">
            @foreach (var accessory in FilteredLegacy)
            {
                <div class="exercise-index-row">
                    <div class="exercise-index-main">
                        <div class="exercise-index-name">@accessory.Name</div>
                        <div class="exercise-index-meta">@(accessory.UserId is null ? "Built-in accessory" : "Custom accessory")</div>
                    </div>
                    @if (accessory.UserId is not null)
                    {
                        <div class="flex gap-1 items-center">
                            <select class="form-control" aria-label="Link @accessory.Name to a library exercise"
                                    @onchange="e => LinkAccessory(accessory.Id, e)">
                                <option value="">Link to…</option>
                                @foreach (var definition in allExercises)
                                {
                                    <option value="@definition.Id">@definition.Name</option>
                                }
                            </select>
                            <button class="btn btn-ghost btn-sm" title="Hide" @onclick="() => HideAccessory(accessory.Id)">Hide</button>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <details class="setup-card mt-3">
        <summary>Add a custom exercise</summary>
        <div class="form-group mt-2">
            <label class="form-label" for="custom-name">Name</label>
            <input id="custom-name" class="form-control" maxlength="100" @bind="customName" />
        </div>
        <div class="flex gap-1">
            <div class="form-group flex-1">
                <label class="form-label" for="custom-muscle">Primary muscle</label>
                <select id="custom-muscle" class="form-control" @bind="customMuscle">
                    @foreach (var muscle in Enum.GetValues<MuscleGroup>())
                    {
                        <option value="@muscle">@muscle</option>
                    }
                </select>
            </div>
            <div class="form-group flex-1">
                <label class="form-label" for="custom-secondary">Secondary muscles</label>
                <input id="custom-secondary" class="form-control" maxlength="200" @bind="customSecondaryMuscles" />
            </div>
        </div>
        <div class="flex gap-1">
            <div class="form-group flex-1">
                <label class="form-label" for="custom-equipment">Equipment</label>
                <input id="custom-equipment" class="form-control" maxlength="100" @bind="customEquipment" />
            </div>
            <div class="form-group flex-1">
                <label class="form-label" for="custom-movement">Movement type</label>
                <input id="custom-movement" class="form-control" maxlength="60" @bind="customMovementType" />
            </div>
        </div>
        <div class="form-group">
            <label class="form-label" for="custom-instructions">Instructions</label>
            <textarea id="custom-instructions" class="form-control" maxlength="2000" rows="3" @bind="customInstructions"></textarea>
        </div>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }
        <button class="btn btn-primary" @onclick="CreateCustomExercise" disabled="@saving">
            @(saving ? "Saving…" : "Save private exercise")
        </button>
    </details>
</div>

@code {
    private List<ExerciseDefinition> exercises = [];
    private List<ExerciseDefinition> allExercises = [];
    private List<Accessory> legacyAccessories = [];
    private List<string> equipmentOptions = [];
    private string search = string.Empty;
    private string? muscleFilter;
    private string equipmentFilter = string.Empty;
    private string customName = string.Empty;
    private MuscleGroup customMuscle = MuscleGroup.Chest;
    private string customSecondaryMuscles = string.Empty;
    private string customEquipment = string.Empty;
    private string customMovementType = string.Empty;
    private string customInstructions = string.Empty;
    private string? error;
    private bool loading = true;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        // Load once the circuit is interactive; prerender shows the loading state instead of querying twice.
        if (!RendererInfo.IsInteractive) return;

        allExercises = await Library.GetExercisesAsync();
        equipmentOptions = allExercises.Select(exercise => exercise.Equipment)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value)
            .ToList();
        exercises = allExercises;
        await LoadLegacyAccessories();
        loading = false;
    }

    private IEnumerable<Accessory> FilteredLegacy =>
        string.IsNullOrEmpty(muscleFilter) && string.IsNullOrEmpty(equipmentFilter)
            ? legacyAccessories.Where(a => string.IsNullOrWhiteSpace(search) || a.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
            : [];

    private async Task LoadLegacyAccessories()
    {
        legacyAccessories = (await AccessoryService.GetAllAccessoriesAsync())
            .Where(a => a.ExerciseDefinitionId is null && a.Category != AccessoryCategory.Cardio)
            .ToList();
    }

    private async Task LinkAccessory(int accessoryId, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var definitionId)) return;
        await AccessoryService.LinkAccessoryAsync(accessoryId, definitionId);
        await LoadLegacyAccessories();
    }

    private async Task HideAccessory(int accessoryId)
    {
        await AccessoryService.DeleteAccessoryAsync(accessoryId);
        await LoadLegacyAccessories();
    }

    private async Task LoadExercises()
    {
        MuscleGroup? muscle = Enum.TryParse<MuscleGroup>(muscleFilter, out var parsed) ? parsed : null;
        exercises = await Library.GetExercisesAsync(search, muscle, equipmentFilter);
    }

    private void OpenExercise(int id) => Nav.NavigateTo($"/exercise-library/{id}");

    private async Task CreateCustomExercise()
    {
        saving = true;
        error = null;
        try
        {
            var exercise = await Library.CreateCustomExerciseAsync(
                customName, customMuscle, customSecondaryMuscles, customEquipment,
                customMovementType, customInstructions);
            Nav.NavigateTo($"/exercise-library/{exercise.Id}");
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
