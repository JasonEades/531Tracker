@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<RestTimerOverlay> Logger
@inject ICurrentUserService UserContext

@* Persistent, always-visible rest-timer badge plus a big center-screen flash
   during the last moments of the rest period, so the timer is never missed
   even if the user has scrolled away from the inline timer controls. *@

@if (RemainingSeconds > 0)
{
    <div class="rest-timer-float @(IsUrgent ? "urgent" : "")" @onclick="OnStopClicked">
        <span class="rest-timer-float-label">Rest</span>
        <span class="rest-timer-float-value">@FormatRest(RemainingSeconds)</span>
    </div>

    @if (IsUrgent)
    {
        <div class="rest-timer-flash" @key="RemainingSeconds" aria-hidden="true">
            <span>@RemainingSeconds</span>
        </div>
    }
}

@code {
    [Parameter] public int RemainingSeconds { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }

    private bool IsUrgent => RemainingSeconds is > 0 and <= 10;
    private int lastRenderedSeconds;
    private bool audioWarningShown;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await UserContext.GetUserIdAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(currentUserId))
        {
            try
            {
                await JS.InvokeVoidAsync("restTimerAudio.setCurrentUser", currentUserId);
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogDebug(ex, "Rest timer audio preference was not loaded because the browser disconnected.");
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Unable to select the current user's rest timer audio preference.");
            }
        }

        if (RemainingSeconds == lastRenderedSeconds)
            return;

        lastRenderedSeconds = RemainingSeconds;
        if (!IsUrgent)
            return;

        try
        {
            if (string.IsNullOrWhiteSpace(currentUserId)
                || !await JS.InvokeAsync<bool>("restTimerAudio.getEnabled", currentUserId))
                return;

            var played = await JS.InvokeAsync<bool>("restTimerAudio.beep", currentUserId);
            if (!played)
                WarnAudioUnavailable();
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "Rest timer audio skipped because the browser disconnected.");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Unable to play rest timer audio.");
            WarnAudioUnavailable();
        }
    }

    private void WarnAudioUnavailable()
    {
        if (audioWarningShown)
            return;

        audioWarningShown = true;
        Snackbar.Add("Countdown sound is unavailable. Tap the page to enable audio; the visual timer will continue.", Severity.Warning);
    }

    private static string FormatRest(int seconds) => $"{seconds / 60}:{seconds % 60:D2}";

    private Task OnStopClicked() => OnStop.InvokeAsync();
}
